---
// Temporary Phase 1 route: direction C. Not for search engines (noindex). Deleted after Saba picks.
import Base from "../../layouts/Base.astro";
import DesignC from "../../designs/c/DesignC.astro";
import { seo } from "../../content/home";
import { profileJsonLd, SITE_ORIGIN } from "../../lib/site";
---
<Base
  title={`${seo.title} (design C)`}
  description={seo.description}
  lang="en"
  path="/design/c"
  noindex
  bodyClass="dc"
  themeColor="#f5f3ec"
  preview="c"
  jsonLd={profileJsonLd({ url: `${SITE_ORIGIN}/design/c`, lang: "en", description: seo.description })}
>
  <DesignC />
</Base>
