---
// Temporary Phase 1 route: direction B plus today's WebGL hero shader (desktop only), to compare
// "immediate wow" against speed. Not for search engines (noindex). Deleted after Saba picks.
import Base from "../../layouts/Base.astro";
import DesignB from "../../designs/b/DesignB.astro";
import { seo } from "../../content/home";
import { profileJsonLd, SITE_ORIGIN } from "../../lib/site";
---
<Base
  title={`${seo.title} (design B-rich)`}
  description={seo.description}
  lang="en"
  path="/design/b-rich"
  noindex
  bodyClass="db"
  themeColor="#0a0a0b"
  colorScheme="dark"
  preview="b-rich"
  jsonLd={profileJsonLd({ url: `${SITE_ORIGIN}/design/b-rich`, lang: "en", description: seo.description })}
>
  <DesignB rich />
</Base>
