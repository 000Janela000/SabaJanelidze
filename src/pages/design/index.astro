---
// Temporary Phase 1 page: the list of design directions. Not for search engines.
import Base from "../../layouts/Base.astro";

const directions = [
  {
    href: "/design/a",
    name: "A · Calm precision",
    line: "Light, lots of space, one quiet green accent. Linear and Stripe restraint; big statement headline.",
  },
  {
    href: "/design/b",
    name: "B · Today's dark identity, made light and fast",
    line: "The current dark palette and blue accent without the heavy effects, plus a small “balanced ledger” accent on desktop.",
  },
  {
    href: "/design/b-rich",
    name: "B-rich · B plus today's moving shader background",
    line: "Same as B, plus today's moving WebGL background behind the hero on desktop (phones and reduced motion get a still gradient). Speed cost: +2 KB of JavaScript and the same lab scores as B, but the graphics chip redraws the background on every frame and it never stops by itself (it has a pause button). On a laptop without a usable graphics chip the page dropped from 165 to about 70 frames per second in our test.",
  },
  {
    href: "/design/c",
    name: "C · Engineering notebook",
    line: "Paper and grid, diagrams and code-like details first, monospace used sparingly, plain words throughout.",
  },
  {
    href: "/ka/design/b",
    name: "B in Georgian (typography check)",
    line: "Hero and What I do of direction B with only the Georgian that was already approved; the rest is marked English.",
  },
];
---
<Base
  title="Design directions — Saba Janelidze (Phase 1 preview)"
  description="Three home-page design directions for the new sabajanelidze.com, for Saba to compare."
  lang="en"
  path="/design"
  noindex
  preview="index"
>
  <main id="main" class="mx-auto max-w-3xl px-5 py-16 md:px-10 md:py-24">
    <p class="text-sm text-muted">Phase 1 · not public · these pages are deleted after you pick</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">Three home-page directions</h1>
    <p class="mt-4 text-muted">
      All three use the same English text, so you compare looks, not words. Open each on your computer and on your
      phone. You can pick one, or mix parts (for example the layout of one and the colours of another).
    </p>
    <ol class="mt-10 divide-y divide-line border-y border-line">
      {
        directions.map((d) => (
          <li class="py-5">
            <a class="text-lg font-semibold underline decoration-line underline-offset-4 hover:decoration-accent" href={d.href}>
              {d.name}
            </a>
            <p class="mt-1 text-muted">{d.line}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-10 text-sm text-muted">
      Each direction follows the same motion rules: the first screen is complete without JavaScript, only transform
      and opacity move, nothing takes over the scroll or the cursor, and reduced motion gets a designed still version.
    </p>
  </main>
</Base>
