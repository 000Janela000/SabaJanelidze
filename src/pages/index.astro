---
// The real home page: the calm design (Phase 1c, 2026-10-15). Direction A's skeleton with real content,
// light and dark themes, no grid, no glow, no explainers that move. Tokens: src/styles/tokens.css.
// Order: hero (pitch, proof, two actions, four numbers) → work → what I do → one static method diagram
// → about → contact. All text: src/content/home.ts (approved by Saba on 2026-10-17).
// Add "ka" back together with the real Georgian page.
import Base from "../shared/components/base-layout.astro";
import Header from "../shared/components/header.astro";
import Footer from "../shared/components/footer.astro";
import Hero from "./_home/hero.astro";
import Work from "./_home/work.astro";
import Services from "./_home/services.astro";
import Method from "./_home/method.astro";
import About from "./_home/about.astro";
import Contact from "./_home/contact.astro";
import { seo } from "./_home/content/seo";
import { profileJsonLd, SITE_ORIGIN } from "../shared/lib/site";
---
<Base
  title={seo.title}
  description={seo.description}
  lang="en"
  path="/"
  ogType="profile"
  jsonLd={profileJsonLd({ url: `${SITE_ORIGIN}/`, lang: "en", description: seo.description })}
>
  <Header />
  <main id="main" tabindex="-1">
    <Hero />
    <Work />
    <Services />
    <Method />
    <About />
    <Contact />
  </main>
  <Footer />
</Base>
