---
// A real 404 page (the old site answered 200 for every unknown address).
import Base from "../shared/components/base-layout.astro";
---
<Base
  title="Page not found — Saba Janelidze"
  description="This page does not exist."
  lang="en"
  path="/404"
  noindex
>
  <main id="main" class="nf">
    <p class="ui-source">404</p>
    <h1 class="ui-display nf-title">This page does not exist</h1>
    <p class="nf-text">
      The address may be mistyped, or the page has not been built yet.
    </p>
    <p class="nf-links">
      <a class="ui-link nf-link" href="/">Home</a>
    </p>
  </main>
</Base>

<style>
  .nf {
    max-width: 48rem;
    margin-inline: auto;
    padding: 6rem 1.25rem;
  }
  .nf-title {
    margin-top: 0.75rem;
    font-size: 1.875rem;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }
  .nf-text {
    margin-top: 1rem;
    color: var(--muted);
  }
  .nf-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .nf-link {
    font-weight: 500;
  }
  @media (min-width: 48rem) {
    .nf {
      padding: 8rem 2.5rem;
    }
    .nf-title {
      font-size: 2.25rem;
      line-height: 2.5rem;
    }
  }
</style>
