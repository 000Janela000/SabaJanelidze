---
// A real 404 page (the old site answered 200 for every unknown address).
import Base from "../layouts/Base.astro";
---
<Base
  title="Page not found — Saba Janelidze"
  description="This page does not exist."
  lang="en"
  path="/404"
  noindex
  themed
>
  <main id="main" class="mx-auto max-w-3xl px-5 py-24 md:px-10 md:py-32">
    <p class="font-mono text-sm text-muted">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">This page does not exist</h1>
    <p class="mt-4 text-muted">
      The address may be mistyped, or the page has not been built yet.
    </p>
    <p class="mt-8 flex flex-wrap gap-6">
      <a class="font-medium underline underline-offset-4" href="/">Home</a>
      <a class="font-medium underline underline-offset-4" href="/ka" lang="ka">ქართული</a>
    </p>
  </main>
</Base>
