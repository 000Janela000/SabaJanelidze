---
// About: the portrait (square, straight on the page colour), the bio, the open-source tools (one line each with
// its proof) and the grouped stack.
import Section from "./section.astro";
import { about } from "./content/about";
import { openSource } from "../../shared/content/open-source";
import { stack } from "../../shared/content/stack";
import { PERSON } from "../../shared/lib/site";
---
<Section id="about" heading={about.heading}>
  <div class="about">
    <img class="about-portrait" src={PERSON.portrait} width="800" height="800" alt={about.portraitAlt} loading="lazy" decoding="async" />
    <div class="about-text">
      {about.bio.map((b) => <p class="about-p">{b}</p>)}

      <h3 class="about-h3">{openSource.heading}</h3>
      <ul class="about-os">
        {
          openSource.items.map((o) => (
            <li>
              <a class="ui-link about-os-name" href={o.href} rel="noopener">{o.name}</a>{`: ${o.text}. `}<span class="about-os-proof">{o.proof}.</span>
            </li>
          ))
        }
      </ul>
      <p class="about-note ui-meta">{openSource.note}</p>

      <h3 class="about-h3">{stack.heading}</h3>
      <dl class="about-stack">
        {
          stack.groups.map((g) => (
            <div>
              <dt>{g.group}</dt>
              <dd>{g.items.join(", ")}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</Section>

<style>
  /* Phones: a square portrait above the text (a float made very short lines). Desktop: two columns. */
  .about-portrait {
    display: block;
    width: 128px;
    height: auto;
    margin: 0 0 var(--space-4);
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: 50% 50%;
    border-radius: var(--radius);
  }
  @media (min-width: 900px) {
    .about {
      display: grid;
      grid-template-columns: 280px minmax(0, 1fr);
      gap: var(--space-8);
      align-items: start;
    }
    .about-portrait {
      width: 100%;
      margin: 0;
    }
  }
  .about-p {
    max-width: 38em;
    margin: 0 0 var(--space-4);
    font-size: var(--fs-md);
  }
  .about-p + .about-p {
    color: var(--muted);
  }
  .about-h3 {
    clear: both;
    margin: var(--space-6) 0 var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    font-size: var(--fs-sm);
    font-weight: var(--weight-strong);
    line-height: 1.4;
  }
  .about-os {
    display: grid;
    gap: var(--space-3);
    max-width: 44em;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--muted);
  }
  .about-os-name {
    font-weight: var(--weight-strong);
  }
  .about-os-proof {
    color: var(--fg);
  }
  .about-note {
    margin: var(--space-3) 0 0;
  }
  .about-stack {
    display: grid;
    gap: var(--space-2);
    max-width: 44em;
    margin: 0;
  }
  .about-stack > div {
    display: grid;
    gap: 0.1rem;
  }
  @media (min-width: 640px) {
    .about-stack > div {
      grid-template-columns: 9.5rem minmax(0, 1fr);
      gap: var(--space-4);
    }
  }
  .about-stack dt {
    font-size: var(--fs-sm);
    color: var(--fg);
    line-height: 1.6;
  }
  .about-stack dd {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--muted);
  }
</style>
