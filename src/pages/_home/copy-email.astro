---
// "Copy" next to the email address: turns into "Copied" for 1.5 s (a text swap, not an animation, so it also
// suits reduced motion) and tells screen readers the result. Hidden without JavaScript; the mailto link still works.
import { contact } from "./content/contact";

---
<button type="button" class="copy-email" data-copy={contact.email} data-copied={contact.copyButton.copied} data-failed={contact.copyButton.failed} aria-label={contact.copyButton.label} hidden>
  <span data-idle>{contact.copyButton.idle}</span>
  <span data-done hidden>{contact.copyButton.done}{" "}<span aria-hidden="true">✓</span></span>
</button>
<span class="sr-only" role="status" aria-atomic="true" data-copy-status></span>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    if (!navigator.clipboard) continue;
    btn.hidden = false;
    const idle = btn.querySelector<HTMLElement>("[data-idle]");
    const done = btn.querySelector<HTMLElement>("[data-done]");
    // The status line sits right after the button; screen readers announce its text.
    const status = btn.nextElementSibling as HTMLElement | null;
    const say = (text: string) => {
      if (status?.hasAttribute("data-copy-status")) status.textContent = text;
    };
    let timer = 0;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
      } catch {
        say(btn.dataset.failed ?? "");
        return;
      }
      say(btn.dataset.copied ?? "");
      if (idle) idle.hidden = true;
      if (done) done.hidden = false;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (idle) idle.hidden = false;
        if (done) done.hidden = true;
      }, 1500);
    });
  }
</script>

<style>
  .copy-email {
    min-height: 36px;
    padding: 0 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-size: var(--fs-sm);
    cursor: pointer;
  }
  .copy-email:hover {
    background: var(--surface-2);
  }
</style>
