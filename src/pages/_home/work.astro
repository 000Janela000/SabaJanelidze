---
// Selected work, right after the hero. Outcome first on every card. Phase 1e (Phase 1d fixes 1, 4, 9):
// - Bitnet is the ONLY big card: a screenshot of the public bitnet.ge page in English (retaken 15 Oct 2026, cropped above its
//   counter strip, with a dated caption in the small mono), the outcome, and two links: bitnet.ge and
//   "Ask me how it was built" (a mailto until /work/bitnet exists).
// - PlayTime, WasteAway, Chama and UniHub are small text cards that show their real stage as a tag.
//   PlayTime and WasteAway also show a small picture of their live English page beside the title (image.thumb, 288 x 180).
// Hover (pointer devices, motion allowed): the Bitnet image lifts 2 px and its border turns accent (150 ms).
import Section from "./section.astro";
import { work } from "./content/work";

const { lead, cards } = work;
const host = (url: string) => url.replace("https://", "");
---
<Section id="work" heading={work.heading}>
  <article class="ui-card wk-lead" id={`work-${lead.slug}`} aria-labelledby={`work-${lead.slug}-title`}>
    <figure class="wk-media">
      <img
        src={lead.image.src}
        width={lead.image.width}
        height={lead.image.height}
        alt={lead.image.alt}
        loading="lazy"
        decoding="async"
      />
      <figcaption class="wk-cap ui-source">{lead.image.caption}</figcaption>
    </figure>
    <div class="wk-body">
      <p class="ui-meta">
        {lead.role}{"\u00a0· "}<span class="ui-source wk-years">{lead.years}</span>
      </p>
      <h3 id={`work-${lead.slug}-title`} class="wk-title">
        {lead.title}
      </h3>
      <p class="wk-outcome">{lead.outcome}</p>
      <p class="wk-text">{lead.text}</p>
      <p class="wk-links">
        <a class="ui-link" href={lead.url} rel="noopener">{host(lead.url)}<span class="ui-arrow" data-dir="out" aria-hidden="true">↗</span></a>
        <a class="ui-link" href={lead.moreLink.href}>{lead.moreLink.label}<span class="ui-arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </article>

  <div class="wk-small">
    {
      cards.map((w) => (
        <article class="wk-mini" id={`work-${w.slug}`} aria-labelledby={`work-${w.slug}-title`}>
          <div class:list={["wk-mini-head", { "has-thumb": w.thumb }]}>
            {w.thumb && (
              <img
                class="wk-thumb"
                src={w.thumb.src}
                width="288"
                height="180"
                alt={w.thumb.alt}
                loading="lazy"
                decoding="async"
              />
            )}
            <div>
              <p class="ui-meta">
                {w.role}{"\u00a0· "}<span class="ui-source wk-years">{w.years}</span>
              </p>
              <h3 id={`work-${w.slug}-title`} class="wk-mini-title">
                {w.title}
              </h3>
            </div>
          </div>
          <p class="wk-stage"><span class="ui-tag">{w.stage}</span></p>
          <p class="wk-mini-text">{w.outcome}</p>
          {w.url && (
            <p class="wk-mini-link">
              <a class="ui-link" href={w.url} rel="noopener">{host(w.url)}<span class="ui-arrow" data-dir="out" aria-hidden="true">↗</span></a>
            </p>
          )}
        </article>
      ))
    }
  </div>
</Section>

<style>
  .wk-lead {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  @media (min-width: 900px) {
    .wk-lead {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
    }
  }
  .wk-media {
    margin: 0;
    padding: var(--space-3) var(--space-3) 0;
  }
  @media (min-width: 900px) {
    .wk-media {
      padding: var(--space-4);
    }
  }
  .wk-media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1440 / 756;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius-card) - 4px);
    background: var(--surface-2);
  }
  /* Hover: a stronger 1 px border on the image; with motion allowed, also a 2 px lift. Only borders and transform. */
  @media (hover: hover) {
    .wk-lead:hover .wk-media img {
      border-color: var(--line-strong);
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .wk-media img {
      transition:
        transform var(--dur-fast) var(--ease-out),
        border-color var(--dur-fast) ease;
    }
    .wk-lead:hover .wk-media img {
      transform: translateY(calc(-1 * var(--nudge)));
    }
  }
  .wk-cap {
    margin-top: var(--space-2);
  }
  .wk-years {
    white-space: nowrap;
  }
  .wk-body {
    display: flex;
    flex-direction: column;
    padding: var(--space-4) var(--space-5) var(--space-5);
  }
  @media (min-width: 900px) {
    .wk-body {
      padding: var(--space-5) var(--space-6) var(--space-5) var(--space-3);
    }
  }
  .wk-title {
    margin: var(--space-1) 0 var(--space-3);
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-optical-sizing: auto;
    font-size: var(--fs-xl);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-heading);
  }
  .wk-outcome {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-lg);
    line-height: 1.45;
  }
  .wk-text {
    margin: 0;
    color: var(--muted);
  }
  .wk-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
    margin: var(--space-4) 0 0;
  }

  .wk-small {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-7);
  }
  @media (min-width: 768px) {
    .wk-small {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-6) var(--space-7);
    }
  }
  .wk-mini {
    display: flex;
    flex-direction: column;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  /* A small picture of the live English page beside the role line and title of the founder cards (PlayTime, WasteAway).
     Small on purpose, so the Bitnet card stays the one big picture: 96 px wide on phones, 120 px from 480 px.
     The stage tag stays under it at full width (PlayTime's tag is too long for the narrow column at 320 px). */
  .wk-mini-head.has-thumb {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: center;
    margin-bottom: var(--space-3);
  }
  @media (min-width: 480px) {
    .wk-mini-head.has-thumb {
      grid-template-columns: 7.5rem minmax(0, 1fr);
    }
  }
  .wk-thumb {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--line);
    border-radius: var(--radius-tag);
    background: var(--surface-2);
  }
  .wk-mini-title {
    margin: var(--space-1) 0 var(--space-2);
    font-size: var(--fs-lg);
    font-weight: var(--weight-strong);
    line-height: var(--lh-heading);
  }
  .has-thumb .wk-mini-title {
    margin-bottom: 0;
  }
  .wk-stage {
    margin: 0 0 var(--space-2);
  }
  .wk-mini-text {
    margin: 0;
    color: var(--muted);
  }
  .wk-mini-link {
    margin: var(--space-2) 0 0;
  }
</style>
