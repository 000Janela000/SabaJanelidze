---
// Selected work: the big Bitnet card (screenshot with a dated caption, the outcome, two links), then four small cards
// that show their real stage as a tag.
// Hover (pointer devices, motion allowed): the Bitnet image lifts 2 px.
import Section from "./section.astro";
import { work } from "./content/work";

const { lead, cards } = work;
const host = (url: string) => url.replace("https://", "");
---
<Section id="work" heading={work.heading}>
  <article class="ui-card work-lead" id={`work-${lead.slug}`} aria-labelledby={`work-${lead.slug}-title`}>
    <figure class="work-media">
      <img
        src={lead.image.src}
        width={lead.image.width}
        height={lead.image.height}
        alt={lead.image.alt}
        loading="lazy"
        decoding="async"
      />
      <figcaption class="work-cap ui-source">{lead.image.caption}</figcaption>
    </figure>
    <div class="work-body">
      <p class="ui-meta">
        {lead.role}{"\u00a0· "}<span class="ui-source work-years">{lead.years}</span>
      </p>
      <h3 id={`work-${lead.slug}-title`} class="ui-display work-title">
        {lead.title}
      </h3>
      <p class="work-outcome">{lead.outcome}</p>
      <p class="work-text">{lead.text}</p>
      <p class="work-links">
        <a class="ui-link" href={lead.url} rel="noopener">{host(lead.url)}<span class="ui-arrow" data-dir="out" aria-hidden="true">↗</span></a>
        <a class="ui-link" href={lead.moreLink.href}>{lead.moreLink.label}<span class="ui-arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </article>

  <div class="work-small">
    {
      cards.map((w) => (
        <article class="work-mini" id={`work-${w.slug}`} aria-labelledby={`work-${w.slug}-title`}>
          <p class="ui-meta">
            {w.role}{"\u00a0· "}<span class="ui-source work-years">{w.years}</span>
          </p>
          <h3 id={`work-${w.slug}-title`} class="work-mini-title">
            {w.title}
          </h3>
          <p class="work-stage"><span class="ui-tag">{w.stage}</span></p>
          <p class="work-mini-text">{w.outcome}</p>
          {w.url && (
            <p class="work-mini-link">
              <a class="ui-link" href={w.url} rel="noopener">{host(w.url)}<span class="ui-arrow" data-dir="out" aria-hidden="true">↗</span></a>
            </p>
          )}
        </article>
      ))
    }
  </div>
</Section>

<style>
  .work-lead {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  @media (min-width: 900px) {
    .work-lead {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
    }
  }
  .work-media {
    margin: 0;
    padding: var(--space-3) var(--space-3) 0;
  }
  @media (min-width: 900px) {
    .work-media {
      padding: var(--space-4);
    }
  }
  .work-media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1440 / 756;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius-card) - 4px);
    background: var(--surface-2);
  }
  /* Hover: a stronger 1 px border on the image; with motion allowed, also a 2 px lift. Only borders and transform. */
  @media (hover: hover) {
    .work-lead:hover .work-media img {
      border-color: var(--line-strong);
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .work-media img {
      transition:
        transform var(--dur-fast) var(--ease-out),
        border-color var(--dur-fast) ease;
    }
    .work-lead:hover .work-media img {
      transform: translateY(calc(-1 * var(--nudge)));
    }
  }
  .work-cap {
    margin-top: var(--space-2);
  }
  .work-years {
    white-space: nowrap;
  }
  .work-body {
    display: flex;
    flex-direction: column;
    padding: var(--space-4) var(--space-5) var(--space-5);
  }
  @media (min-width: 900px) {
    .work-body {
      padding: var(--space-5) var(--space-6) var(--space-5) var(--space-3);
    }
  }
  .work-title {
    margin: var(--space-1) 0 var(--space-3);
    font-size: var(--fs-xl);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-heading);
  }
  .work-outcome {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-lg);
    line-height: 1.45;
  }
  .work-text {
    margin: 0;
    color: var(--muted);
  }
  .work-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
    margin: var(--space-4) 0 0;
  }

  .work-small {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-7);
  }
  @media (min-width: 768px) {
    .work-small {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-6) var(--space-7);
    }
  }
  .work-mini {
    display: flex;
    flex-direction: column;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .work-mini-title {
    margin: var(--space-1) 0 var(--space-2);
    font-size: var(--fs-lg);
    font-weight: var(--weight-strong);
    line-height: var(--lh-heading);
  }
  .work-stage {
    margin: 0 0 var(--space-2);
  }
  .work-mini-text {
    margin: 0;
    color: var(--muted);
  }
  .work-mini-link {
    margin: var(--space-2) 0 0;
  }
</style>
