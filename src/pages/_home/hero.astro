---
// The first screen, complete without JavaScript (motion rule 1). Desktop (1024 px and up): two columns, the text left
// and the race figure right; the four numbers run under both. Phones and tablets: the text, the figure, the numbers 2 x 2.
// The numbers use a subgrid, so value, label and source line up across a row whatever the label length.
import HeroRace from "./hero-race.astro";
import { hero } from "./content/hero";
---
<section class="hero" aria-labelledby="hero-title">
  <div class="ui-wrap hero-grid">
    <div class="hero-main">
      <h1 id="hero-title" class="ui-display hero-name">{hero.name}</h1>
      <p class="hero-role">{hero.role}</p>
      <p class="ui-display hero-statement">
        {hero.statement.map((sentence, i) => <span class="hero-sentence">{sentence}{i < hero.statement.length - 1 ? " " : ""}</span>)}
      </p>
      <p class="hero-built">{hero.built}</p>
      <p class="hero-path">{hero.path}</p>
      <div class="hero-actions">
        <a class="ui-btn" href={hero.emailButton.href}>{hero.emailButton.label}</a>
        <a class="ui-action hero-hire" href={hero.cvLink.href}>{hero.cvLink.label}<span class="ui-arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="hero-figure">
      <HeroRace />
    </div>
    <ul class="hero-nums" aria-label="In numbers">
      {
        hero.numbers.map((n) => (
          <li class="hero-num">
            <span class="ui-display hero-num-value">{n.value}</span>
            <span class="hero-num-label">
              <span class="hero-num-long">{n.label}</span>
              <span class="hero-num-short">{n.labelShort}</span>
            </span>
            <span class="hero-num-src ui-source">
              {n.sourceShort ? (
                <Fragment>
                  <span class="hero-num-long">{n.source}</span>
                  <span class="hero-num-short">{n.sourceShort}</span>
                </Fragment>
              ) : (
                n.source
              )}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(2.25rem, 5vw, 4.5rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-7);
  }
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--space-7);
      row-gap: var(--space-8);
      /* Top-aligned: the figure never moves when the heading font swaps in or the pitch rewraps. */
      align-items: start;
    }
    .hero-figure {
      justify-self: end;
      width: 100%;
      max-width: 28rem; /* the figure's own limit, 448 px */
    }
    .hero-nums {
      grid-column: 1 / -1;
    }
  }

  /* His name is the h1, the biggest text on the page; the role sits right under it. */
  .hero-name {
    margin: 0;
    font-size: var(--fs-hero);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-display);
  }
  .hero-role {
    margin: var(--space-2) 0 0;
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  /* His path in one statement, at a medium size; each sentence starts on its own line. */
  .hero-statement {
    max-width: 22em;
    margin: var(--space-5) 0 0;
    font-size: var(--fs-xl);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-heading);
    text-wrap: balance;
  }
  .hero-sentence {
    display: block;
    text-wrap: balance;
  }
  /* What he built, then the dated path (smaller, muted), under the statement. */
  .hero-built {
    max-width: 32em;
    margin: var(--space-5) 0 0;
    font-size: var(--fs-md);
    text-wrap: pretty;
  }
  .hero-path {
    max-width: 36em;
    margin: var(--space-3) 0 0;
    font-size: var(--fs-base);
    color: var(--muted);
    text-wrap: pretty;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-6);
  }
  /* The quiet recruiter route: regular weight, same accent underline. */
  .hero-hire {
    font-weight: var(--weight-regular);
  }

  /* The numbers: 2 x 2 on phones, one row of four from 900 px. Value in Newsreader, source in the small mono.
     Each item spans three rows of the list's grid (subgrid), so the sources line up across a row. */
  .hero-nums {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-5);
    row-gap: 0;
    margin: 0;
    padding: var(--space-5) 0 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .hero-num {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    row-gap: var(--space-1);
    align-content: start;
    min-width: 0;
  }
  .hero-num:nth-child(n + 3) {
    padding-top: var(--space-5);
  }
  @media (min-width: 900px) {
    .hero-nums {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: var(--space-6);
      padding-top: var(--space-6);
    }
    .hero-num:nth-child(n + 3) {
      padding-top: 0;
    }
  }
  .hero-num-value {
    font-size: var(--fs-xl);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    letter-spacing: var(--tracking-heading);
    white-space: nowrap;
  }
  .hero-num-label {
    font-size: var(--fs-sm);
    line-height: 1.4;
  }
  .hero-num-long {
    display: none;
  }
  @media (min-width: 640px) {
    .hero-num-long {
      display: inline;
    }
    .hero-num-short {
      display: none;
    }
  }
  @media (min-width: 900px) {
    .hero-num-label {
      font-size: var(--fs-base);
      line-height: 1.45;
    }
  }
  .hero-num-src {
    margin-top: var(--space-1);
  }
  /* Phones: the sources one size down, so each fits on one line in its half of the row. */
  @media (max-width: 639px) {
    .hero-nums {
      column-gap: var(--space-4);
    }
    .hero-num-src {
      font-size: var(--fs-xs);
    }
  }
</style>
