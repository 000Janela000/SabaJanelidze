---
// "Let's talk": the email button, the address with Copy, LinkedIn and GitHub.
import Section from "./section.astro";
import CopyEmail from "./copy-email.astro";
import { contact } from "./content/contact";
---
<Section id="contact" heading={contact.heading} intro={contact.text}>
  <div class="contact-actions">
    <a class="ui-btn" href={contact.emailButton.href}>{contact.emailButton.label}</a>
    <span class="contact-email">
      <a class="ui-link" href={`mailto:${contact.email}`}>{contact.email}</a>
      <CopyEmail />
    </span>
  </div>
  <p class="contact-links">
    {
      contact.profileLinks.map((l) => (
        <a class="ui-link" href={l.href} rel="noopener me">
          {l.label}
        </a>
      ))
    }
  </p>
</Section>

<style>
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
  }
  .contact-email {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-md);
  }
  .contact-links {
    display: flex;
    gap: var(--space-5);
    margin: var(--space-5) 0 0;
  }
</style>
