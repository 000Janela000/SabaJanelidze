---
// "Work with me": the kinds of work, each with one proof line that points at the evidence.
// Columns on desktop, a plain list on phones.
import Section from "./section.astro";
import { services } from "./content/services";
---
<Section id="services" heading={services.heading} intro={services.intro}>
  <ul class="services">
    {
      services.items.map((o) => (
        <li class="services-item">
          <h3 class="services-title">{o.title}</h3>
          <p class="services-text">{o.text}</p>
          <p class="services-proof">
            {o.proof}{" "}
            <a class="ui-link services-link" href={o.proofLink.href}>
              {o.proofLink.label}<span class="ui-arrow" data-dir="down" aria-hidden="true">↓</span>
            </a>
          </p>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .services {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 900px) {
    .services {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
  .services-item {
    display: flex;
    flex-direction: column;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .services-title {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-lg);
    font-weight: var(--weight-strong);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .services-text {
    margin: 0;
    color: var(--muted);
  }
  /* The proof line: smaller, in --fg, at the bottom of the column so the three line up on desktop. */
  .services-proof {
    margin: var(--space-4) 0 0;
    padding-top: var(--space-3);
    border-top: 1px dashed var(--line);
    font-size: var(--fs-sm);
    line-height: 1.5;
  }
  @media (min-width: 900px) {
    .services-text {
      margin-bottom: var(--space-4);
    }
  }
  .services-link {
    white-space: nowrap;
  }
</style>
