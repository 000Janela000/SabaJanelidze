---
// Work with me: the kinds of work (two since the positioning review, 2026-10-19). Columns on desktop, a plain list on phones.
// Phase 1e (Phase 1d fix 7): each offer ends with one proof line that points at the evidence.
import Section from "./section.astro";
import { services } from "./content/services";
---
<Section id="services" heading={services.heading} intro={services.intro}>
  <ul class="of">
    {
      services.items.map((o) => (
        <li class="of-item">
          <h3 class="of-title">{o.title}</h3>
          <p class="of-text">{o.text}</p>
          <p class="of-proof">
            {o.proof}{" "}
            <a class="ui-link of-link" href={o.proofLink.href}>
              {o.proofLink.label}<span class="ui-arrow" data-dir="down" aria-hidden="true">↓</span>
            </a>
          </p>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .of {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 900px) {
    .of {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
  .of-item {
    display: flex;
    flex-direction: column;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .of-title {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-lg);
    font-weight: var(--weight-strong);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .of-text {
    margin: 0;
    color: var(--muted);
  }
  /* The proof line: smaller, in --fg, at the bottom of the column so the three line up on desktop. */
  .of-proof {
    margin: var(--space-4) 0 0;
    padding-top: var(--space-3);
    border-top: 1px dashed var(--line);
    font-size: var(--fs-sm);
    line-height: 1.5;
  }
  @media (min-width: 900px) {
    .of-text {
      margin-bottom: var(--space-4);
    }
  }
  .of-link {
    white-space: nowrap;
  }
</style>
