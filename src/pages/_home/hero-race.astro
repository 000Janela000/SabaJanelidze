---
// The payment-race figure in the hero: hosts the lab's shared element <race-figure>, vendored byte for byte in
// src/vendor/race-figure/ (VENDOR.md there: version, source commit, how to update; never edit those files).
//   - HTML: the element's end state (the losing order 11 of 54) is written into the page, so it shows without
//     JavaScript and with reduced motion. Only the lab address gets "?from=portfolio-home".
//   - CSS: imported, so Astro inlines it with the page's styles. It styles only through --rf-* variables, which
//     default to our tokens (--accent for movement and links, --danger for the loss only).
//   - JS: loaded on idle, as its own file. It plays once when half of the figure is on screen; reduced motion: nothing moves.
//   - Never describe it as "running live": each run is a recorded trace of the game's real code, tested on every build.
// The boundary: this site owns the slot (where it sits, at most 448 px wide on desktop) and the one line above it;
// everything inside <race-figure>, including its texts, belongs to the lab.
import "../../vendor/race-figure/race-figure.css";
import fallback from "../../vendor/race-figure/race-figure.html?raw";
import { hero } from "./content/hero";

const LAB = "https://lab.sabajanelidze.com/day/payments";
const TAGGED = `${LAB}?from=portfolio-home`;
// The address appears twice since 1.0.0 (lab-url and the link, "Reproduce it yourself →" since 1.1.0). Fail the build if a new version
// changes that, so the tag can never be dropped silently.
const hits = fallback.split(`"${LAB}"`).length - 1;
if (hits !== 2) throw new Error(`race-figure.html: expected the lab address twice, found ${hits}. Check the new version.`);
const html = fallback.replaceAll(`"${LAB}"`, `"${TAGGED}"`).trim();
---
<p class="race-lede">{hero.figureIntro}</p>
<div class="race" data-race-slot set:html={html} />

<script>
  // Load the element when the browser is idle (the HTML above already shows the end state).
  // "?url": Vite ships the vendored file byte for byte as its own hashed file and gives us its address.
  // A plain <script type="module"> keeps this loader tiny (a dynamic import() would pull in Vite's 1.6 KB preload helper).
  import figure from "../../vendor/race-figure/race-figure.js?url";
  const load = () => {
    const s = document.createElement("script");
    s.type = "module";
    s.src = figure;
    document.head.append(s);
  };
  if ("requestIdleCallback" in window) requestIdleCallback(load, { timeout: 2500 });
  else setTimeout(load, 1);
</script>

<style>
  /* The line above the figure: small, calm, never on a tint or a line (contrast rule). */
  .race-lede {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-sm);
    line-height: 1.45;
    color: var(--muted);
    text-wrap: pretty;
  }
  /* Only --rf-* variables (the element's contract). Money figures in the small mono (tokens v3). */
  .race :global(race-figure) {
    --rf-mono: var(--font-source);
  }
  /* At 360 px the step "read the balance, check 80 ≤ balance" wraps to three lines; give each step row room for them. */
  @media (max-width: 23rem) {
    .race :global(race-figure) {
      --rf-row: 3.3rem;
    }
  }
</style>
