---
// /cv, for hiring managers: a dated role list. Text: ./_cv/content.ts. Not for search engines (noindex).
import Base from "../shared/components/base-layout.astro";
import Header from "../shared/components/header.astro";
import Footer from "../shared/components/footer.astro";
import { cv } from "./_cv/content";
import { PERSON } from "../shared/lib/site";
---
<Base
  title="CV — Saba Janelidze"
  description="Saba Janelidze's work history: Principal Engineer at Bitnet, Backend Lead at Chama, founder of PlayTime, WasteAway and UniHub."
  lang="en"
  path="/cv"
  noindex
>
  <Header />
  <main id="main" class="ui-wrap ui-page">
    <h1 class="ui-display ui-page-title">{cv.title}</h1>
    <p class="ui-page-lead">{cv.lead}</p>
    <p class="ui-page-actions">
      <a class="ui-btn" href={cv.pdf.href}>{cv.pdf.label}</a>
      <a class="ui-action" href={cv.linkedin.href} rel="noopener me">{cv.linkedin.label}<span class="ui-arrow" data-dir="out" aria-hidden="true">↗</span></a>
    </p>

    <section class="cv-sec" aria-labelledby="cv-work">
      <h2 id="cv-work" class="ui-display cv-h2">{cv.jobsHeading}</h2>
      <ol class="cv-list">
        {
          cv.jobs.map((j) => (
            <li class="cv-job">
              <p class="cv-when ui-source">{j.when}</p>
              <div class="cv-body">
                <h3 class="cv-org">
                  {j.title}, {j.org}
                </h3>
                <p class="cv-kind">{j.kind}</p>
                {j.roles && (
                  <ol class="cv-roles">
                    {j.roles.map((r) => (
                      <li>
                        <span class="cv-role-when ui-source">{r.when}</span>
                        <span class="cv-role-what">{r.what}</span>
                        {r.points && (
                          <ul class="cv-points">
                            {r.points.map((p) => (
                              <li>{p}</li>
                            ))}
                          </ul>
                        )}
                      </li>
                    ))}
                  </ol>
                )}
                {j.points && (
                  <ul class="cv-points">
                    {j.points.map((p) => (
                      <li>{p}</li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="cv-sec" aria-labelledby="cv-own">
      <h2 id="cv-own" class="ui-display cv-h2">{cv.ownHeading}</h2>
      <ol class="cv-list">
        {
          cv.own.map((j) => (
            <li class="cv-job">
              <p class="cv-when ui-source">{j.when}</p>
              <div class="cv-body">
                <h3 class="cv-org">
                  {j.title}, {j.org}
                </h3>
                <p class="cv-kind">{j.kind}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="cv-sec cv-short" aria-labelledby="cv-open">
      <h2 id="cv-open" class="ui-display cv-h2">{cv.openHeading}</h2>
      <p>{cv.open}</p>
      <h2 class="ui-display cv-h2 cv-h2--next">{cv.stackHeading}</h2>
      <p>{cv.stack}</p>
    </section>

    <p class="ui-page-note cv-note">
      Email:{" "}<a class="ui-link" href={`mailto:${PERSON.email}`}>{PERSON.email}</a>
    </p>
  </main>
  <Footer onCv />
</Base>

<style>
  .cv-note {
    margin-top: var(--space-7);
  }
  .cv-sec {
    max-width: 52rem;
    margin-top: var(--space-8);
  }
  .cv-h2 {
    margin: 0 0 var(--space-4);
    font-size: var(--fs-xl);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-heading);
  }
  .cv-h2--next {
    margin-top: var(--space-6);
  }
  .cv-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cv-job {
    display: grid;
    gap: var(--space-1) var(--space-5);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .cv-job {
      grid-template-columns: 9.5rem minmax(0, 1fr);
    }
  }
  .cv-when {
    margin: 0;
    padding-top: 0.15rem;
  }
  .cv-org {
    margin: 0;
    font-size: var(--fs-lg);
    font-weight: var(--weight-strong);
    line-height: 1.35;
  }
  .cv-kind {
    margin: var(--space-1) 0 0;
    color: var(--muted);
  }
  .cv-roles {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }
  .cv-roles > li {
    display: grid;
    gap: 0.1rem var(--space-4);
  }
  @media (min-width: 640px) {
    .cv-roles > li {
      grid-template-columns: 6.5rem minmax(0, 1fr);
    }
    .cv-roles .cv-points {
      grid-column: 2;
    }
  }
  .cv-points {
    margin: var(--space-2) 0 0;
    padding-left: 1.1rem;
    color: var(--muted);
  }
  .cv-points li + li {
    margin-top: var(--space-1);
  }
  .cv-short p {
    margin: 0;
    max-width: 44em;
    color: var(--muted);
  }
</style>
