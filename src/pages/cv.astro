---
// /cv, for hiring managers: name, role, place and contact first, then a dated role list. Text: ./_cv/content.ts.
// The same page prints to the PDF (scripts/cv-pdf.mjs), so the print rules below hide the site chrome and use
// dark text on white whatever the theme. Not for search engines (noindex).
import Base from "../shared/components/base-layout.astro";
import Header from "../shared/components/header.astro";
import Footer from "../shared/components/footer.astro";
import { cv } from "./_cv/content";
import { openSource } from "../shared/content/open-source";
import { stack } from "../shared/content/stack";
---
<Base
  title="CV — Saba Janelidze"
  description="Saba Janelidze's work history: Principal Engineer at Bitnet, Backend Lead at Chama, founder of PlayTime, WasteAway and UniHub."
  lang="en"
  path="/cv"
  noindex
>
  <Header />
  <main id="main" class="ui-wrap ui-page">
    <h1 class="ui-display ui-page-title">{cv.name}</h1>
    <p class="cv-role">{cv.role}</p>
    <p class="cv-contact">
      <span>{cv.place}</span>
      <a class="ui-link" href={`mailto:${cv.email}`}>{cv.email}</a>
      {cv.profileLinks.map((l) => <a class="ui-link" href={l.href} rel="noopener me">{l.label}</a>)}
    </p>
    <p class="ui-page-lead cv-summary">{cv.summary}</p>
    <p class="cv-open">{cv.availability}</p>
    <p class="ui-page-actions cv-actions">
      <a class="ui-btn" href={cv.pdfLink.href} download>{cv.pdfLink.label}</a>
    </p>

    <section class="cv-sec" aria-labelledby="cv-work">
      <h2 id="cv-work" class="ui-display cv-h2">{cv.jobsHeading}</h2>
      <ol class="cv-list">
        {
          cv.jobs.map((j) => (
            <li class="cv-job">
              <p class="cv-when ui-source">{j.when}</p>
              <div class="cv-body">
                <h3 class="cv-org">
                  {j.org}
                  {j.title && <span class="cv-title">{` · ${j.title}`}</span>}
                </h3>
                <p class="cv-kind">{j.kind}</p>
                {j.roles && (
                  <ol class="cv-roles">
                    {j.roles.map((r) => (
                      <li>
                        <span class="cv-role-when ui-source">{r.when}</span>
                        <span class="cv-role-what">
                          {r.title && <strong>{`${r.title}: `}</strong>}
                          {r.what}
                        </span>
                        {r.points && (
                          <ul class="cv-points">
                            {r.points.map((p) => (
                              <li>{p}</li>
                            ))}
                          </ul>
                        )}
                      </li>
                    ))}
                  </ol>
                )}
                {j.points && (
                  <ul class="cv-points">
                    {j.points.map((p) => (
                      <li>{p}</li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="cv-sec" aria-labelledby="cv-own">
      <h2 id="cv-own" class="ui-display cv-h2">{cv.ownHeading}</h2>
      <ol class="cv-list">
        {
          cv.own.map((j) => (
            <li class="cv-job">
              <p class="cv-when ui-source">{j.when}</p>
              <div class="cv-body">
                <h3 class="cv-org">
                  {j.org}
                  <span class="cv-title">{` · ${j.title}`}</span>
                </h3>
                <p class="cv-kind">{j.kind}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="cv-sec cv-short" aria-labelledby="cv-open-source">
      <h2 id="cv-open-source" class="ui-display cv-h2">{openSource.heading}</h2>
      <p class="cv-intro">{cv.openSourceIntro}</p>
      <ul class="cv-lines">
        {
          openSource.items.map((o) => (
            <li>
              <a class="ui-link" href={o.href} rel="noopener">{o.name}</a>{`: ${o.text}. ${o.proof}.`}
            </li>
          ))
        }
      </ul>

      <h2 class="ui-display cv-h2 cv-h2--next">{stack.heading}</h2>
      <ul class="cv-lines">
        {
          stack.groups.map((g) => (
            <li>
              <strong>{g.group}:</strong>{` ${g.items.join(", ")}`}
            </li>
          ))
        }
      </ul>

      <h2 class="ui-display cv-h2 cv-h2--next">{cv.languagesHeading}</h2>
      <p>{cv.languages}</p>
    </section>
  </main>
  <Footer onCv />
</Base>

<style>
  .cv-role {
    margin: var(--space-2) 0 0;
    color: var(--muted);
  }
  .cv-contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: var(--space-3) 0 0;
    font-size: var(--fs-sm);
  }
  .cv-summary {
    margin-top: var(--space-5);
  }
  .cv-open {
    max-width: 38em;
    margin: 0 0 var(--space-5);
    font-weight: var(--weight-strong);
  }
  .cv-sec {
    max-width: 52rem;
    margin-top: var(--space-8);
  }
  .cv-h2 {
    margin: 0 0 var(--space-4);
    font-size: var(--fs-xl);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-heading);
  }
  .cv-h2--next {
    margin-top: var(--space-6);
  }
  .cv-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cv-job {
    display: grid;
    gap: var(--space-1) var(--space-5);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .cv-job {
      grid-template-columns: 9.5rem minmax(0, 1fr);
    }
  }
  .cv-when {
    margin: 0;
    padding-top: 0.15rem;
  }
  .cv-org {
    margin: 0;
    font-size: var(--fs-lg);
    font-weight: var(--weight-strong);
    line-height: 1.35;
  }
  .cv-title {
    font-weight: var(--weight-regular);
    color: var(--muted);
  }
  .cv-kind {
    margin: var(--space-1) 0 0;
    color: var(--muted);
  }
  .cv-roles {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }
  .cv-roles > li {
    display: grid;
    gap: 0.1rem var(--space-4);
  }
  @media (min-width: 640px) {
    .cv-roles > li {
      grid-template-columns: 6.5rem minmax(0, 1fr);
    }
    .cv-roles .cv-points {
      grid-column: 2;
    }
  }
  .cv-points {
    margin: var(--space-2) 0 0;
    padding-left: 1.1rem;
    color: var(--muted);
    list-style: disc;
  }
  .cv-points li + li {
    margin-top: var(--space-1);
  }
  .cv-lines {
    display: grid;
    gap: var(--space-2);
    max-width: 44em;
    margin: 0;
    padding: 0;
    color: var(--muted);
  }
  .cv-short .cv-intro {
    margin-bottom: var(--space-3);
  }
  .cv-short p {
    margin: 0;
    max-width: 44em;
    color: var(--muted);
  }

  /* The PDF: no site chrome, no button, dark text on white whatever the theme (links stay clickable).
     A 13 px root scales every rem size down (body text about 10 pt), so the CV fits on two A4 pages. */
  @media print {
    @page {
      size: A4;
      margin: 14mm 16mm;
    }
    :global(html) {
      font-size: 13px;
    }
    :global(:root) {
      --bg: #ffffff;
      --surface: #ffffff;
      --fg: #111111;
      --muted: #3d3d3d;
      --line: #cccccc;
      --accent: #111111;
    }
    :global(.header),
    :global(.footer),
    :global(.skip-link),
    .cv-actions {
      display: none;
    }
    .ui-page {
      padding-top: 0;
    }
    .cv-summary {
      max-width: none;
    }
    .cv-sec {
      max-width: none;
      margin-top: var(--space-6);
    }
    .cv-job {
      grid-template-columns: 8rem minmax(0, 1fr);
    }
    /* A long job may break between its roles; a heading never ends a page. */
    .cv-roles > li,
    .cv-points li,
    .cv-job:not(:has(.cv-roles)) {
      break-inside: avoid;
    }
    .cv-h2,
    .cv-org,
    .cv-kind {
      break-after: avoid;
    }
  }
</style>
