---
// /cv: "For hiring managers". A short, honest page until the real experience page and PDF exist
// (plan section 2): LinkedIn has the full history, and the CV is sent on request. Not for search engines yet.
import Base from "../layouts/Base.astro";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import { PERSON } from "../lib/site";

const cvMail = `mailto:${PERSON.email}?subject=${encodeURIComponent("CV request")}`;
---
<Base
  title="For hiring managers — Saba Janelidze"
  description="Saba Janelidze's work history and CV."
  lang="en"
  path="/cv"
  noindex
  themed
>
  <Header />
  <main id="main" class="ui-wrap ph">
    <h1 class="ph-h1">For hiring managers</h1>
    <p class="ph-lead">
      My full work history is on LinkedIn. I send my CV on request: email me and I'll reply with it.
    </p>
    <p class="ph-actions">
      <a class="ui-btn" href={PERSON.profiles.linkedin} rel="noopener me">LinkedIn</a>
      <a class="ui-action" href={cvMail}>Ask for my CV{" "}<span aria-hidden="true">→</span></a>
    </p>
    <p class="ph-note">
      Email:{" "}<a class="ui-link" href={`mailto:${PERSON.email}`}>{PERSON.email}</a>
    </p>
  </main>
  <Footer />
</Base>

<style>
  .ph {
    padding-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: var(--space-6);
  }
  .ph-h1 {
    margin: 0;
    font-size: var(--fs-2xl);
    font-weight: var(--weight-strong);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-heading);
  }
  .ph-lead {
    max-width: 34em;
    margin: var(--space-4) 0 var(--space-6);
    font-size: var(--fs-md);
    color: var(--muted);
  }
  .ph-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    margin: 0;
  }
  .ph-note {
    margin: var(--space-5) 0 0;
    color: var(--muted);
  }
</style>
