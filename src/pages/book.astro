---
// /book: an honest "Get in touch" page (no booking calendar yet). The lab's links point here with
// ?from=<place> (for example ?from=lab-payments), so this path must keep working and keep the query string.
// A tiny script reads "from" (letters, digits and dashes only, at most 40 characters), keeps it on <main>
// as data-from (ready to be shown or logged later), and adds it to the email as a short reference line.
// Later this page can forward to a booking calendar; it must keep ?from= when it does. Not for search engines.
import Base from "../shared/components/base-layout.astro";
import Header from "../shared/components/header.astro";
import Footer from "../shared/components/footer.astro";
import { PERSON } from "../shared/lib/site";
import { introEmail, introEmailHref } from "../shared/content/intro-email";

// The same intro email as the home page: a subject and four short prompts.
const mail = introEmailHref();
---
<Base
  title="Get in touch — Saba Janelidze"
  description="Email Saba Janelidze or find him on LinkedIn."
  lang="en"
  path="/book"
  noindex
>
  <Header />
  <main id="main" class="ui-wrap ui-page" data-get-in-touch>
    <h1 class="ui-display ui-page-title">Get in touch</h1>
    <p class="ui-page-lead">
      Email is the easiest way to reach me. Send a line about your team and what you'd like to talk about, and I'll
      suggest a time for a short call.
    </p>
    <p class="ui-page-actions">
      <a class="ui-btn" href={mail} data-mail data-subject={introEmail.subject} data-body={introEmail.body}>Email me</a>
      <a class="ui-action" href={PERSON.profiles.linkedin} rel="noopener me">LinkedIn<span class="ui-arrow" data-dir="out" aria-hidden="true">↗</span></a>
    </p>
    <p class="ui-page-note">
      Or write to{" "}<a class="ui-link" href={`mailto:${PERSON.email}`}>{PERSON.email}</a>{" "}directly.
    </p>
  </main>
  <Footer />
</Base>

<script>
  const main = document.querySelector<HTMLElement>("[data-get-in-touch]");
  const raw = new URLSearchParams(location.search).get("from") ?? "";
  const from = /^[a-z0-9-]{1,40}$/i.test(raw) ? raw.toLowerCase() : "";
  if (main && from) {
    main.dataset.from = from;
    const link = main.querySelector<HTMLAnchorElement>("[data-mail]");
    if (link) {
      const to = link.href.split("?")[0];
      const body = `${link.dataset.body ?? ""}\n—\nvia sabajanelidze.com (${from})`;
      link.href = `${to}?subject=${encodeURIComponent(link.dataset.subject ?? "")}&body=${encodeURIComponent(body)}`;
    }
  }
</script>

