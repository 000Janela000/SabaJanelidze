---
// /book: an honest "Get in touch" page (no booking calendar yet). The lab's links point here with
// ?from=<place> (for example ?from=lab-payments), so this path must keep working and keep the query string.
// A tiny script reads "from" (letters, digits and dashes only, at most 40 characters), keeps it on <main>
// as data-from (ready to be shown or logged later), and adds it to the email as a short reference line.
// Later this page can forward to a booking calendar; it must keep ?from= when it does. Not for search engines.
import Base from "../layouts/Base.astro";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import { PERSON } from "../lib/site";

const subject = "Hello";
const mail = `mailto:${PERSON.email}?subject=${encodeURIComponent(subject)}`;
---
<Base
  title="Get in touch — Saba Janelidze"
  description="Email Saba Janelidze or find him on LinkedIn."
  lang="en"
  path="/book"
  noindex
  themed
>
  <Header />
  <main id="main" class="ui-wrap ph" data-get-in-touch>
    <h1 class="ph-h1">Get in touch</h1>
    <p class="ph-lead">
      Email is the easiest way to reach me. Send a line about your team and what you'd like to talk about, and I'll
      suggest a time for a short call.
    </p>
    <p class="ph-actions">
      <a class="ui-btn" href={mail} data-mail>Email me</a>
      <a class="ui-action" href={PERSON.profiles.linkedin} rel="noopener me">LinkedIn{" "}<span aria-hidden="true">↗</span></a>
    </p>
    <p class="ph-note">
      Or write to{" "}<a class="ui-link" href={`mailto:${PERSON.email}`}>{PERSON.email}</a>{" "}directly.
    </p>
  </main>
  <Footer />
</Base>

<script>
  const main = document.querySelector<HTMLElement>("[data-get-in-touch]");
  const raw = new URLSearchParams(location.search).get("from") ?? "";
  const from = /^[a-z0-9-]{1,40}$/i.test(raw) ? raw.toLowerCase() : "";
  if (main && from) {
    main.dataset.from = from;
    const link = main.querySelector<HTMLAnchorElement>("[data-mail]");
    if (link) link.href += `&body=${encodeURIComponent(`\n\n—\nvia sabajanelidze.com (${from})`)}`;
  }
</script>

<style>
  .ph {
    padding-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: var(--space-6);
  }
  .ph-h1 {
    margin: 0;
    font-size: var(--fs-2xl);
    font-weight: var(--weight-strong);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-heading);
  }
  .ph-lead {
    max-width: 34em;
    margin: var(--space-4) 0 var(--space-6);
    font-size: var(--fs-md);
    color: var(--muted);
  }
  .ph-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    margin: 0;
  }
  .ph-note {
    margin: var(--space-5) 0 0;
    color: var(--muted);
  }
</style>
