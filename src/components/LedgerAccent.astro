---
// Signature moment 1 (direction B only): the quiet "balanced ledger" accent beside the hero.
// Pairs of equal debit and credit marks slide in and cancel out, then "Σ 0.00" shows. It settles to a
// still frame after about 4 seconds and never moves again.
// - Desktop only (wide screen with a mouse). Hidden on phones.
// - Starts after the page has loaded and the browser is idle. The hero text never waits for it.
// - Reduced motion or no JavaScript: the settled still frame, no movement.
// - Only transform and opacity move. The script is a few hundred bytes.
const pairs = [62, 38, 84, 26, 54, 70];
---
<figure class="ledger" data-ledger data-state="pre" aria-hidden="true">
  <div class="ledger-head">
    <span>debit</span>
    <span>credit</span>
  </div>
  <div class="ledger-rows">
    {
      pairs.map((w) => (
        <div class="ledger-row" style={`--w:${w}%`}>
          <span class="ledger-bar ledger-bar--debit" />
          <span class="ledger-bar ledger-bar--credit" />
        </div>
      ))
    }
  </div>
  <div class="ledger-sum">
    <span class="ledger-sigma">Σ</span>
    <span class="tabular">0.00</span>
    <span class="ledger-ok">balanced</span>
  </div>
  <figcaption class="ledger-caption">Every money move is two entries that sum to zero.</figcaption>
</figure>
<noscript>
  <style is:inline>
    .ledger .ledger-bar,
    .ledger .ledger-sum {
      opacity: 1 !important;
      transform: none !important;
    }
  </style>
</noscript>

<style>
  .ledger {
    display: none;
    margin: 0;
    width: 100%;
    max-width: 340px;
    padding: 1.25rem 1.25rem 1rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    font-size: 0.75rem;
    color: var(--muted);
  }
  @media (min-width: 1024px) {
    .ledger {
      display: block;
    }
  }
  .ledger-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-bottom: 0.75rem;
  }
  .ledger-head span:first-child {
    text-align: right;
    padding-right: 0.75rem;
  }
  .ledger-head span:last-child {
    padding-left: 0.75rem;
  }
  .ledger-rows {
    position: relative;
    display: grid;
    gap: 0.7rem;
    padding: 0.25rem 0;
  }
  .ledger-rows::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--line);
  }
  .ledger-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 6px;
  }
  .ledger-bar {
    height: 8px;
    width: var(--w);
    border-radius: 2px;
  }
  .ledger-bar--debit {
    justify-self: end;
    background: var(--accent);
  }
  .ledger-bar--credit {
    justify-self: start;
    background: var(--fg);
    opacity: 0.8;
  }
  .ledger-sum {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--fg);
  }
  .ledger-sigma {
    color: var(--muted);
  }
  .ledger-ok {
    color: var(--accent);
    font-size: 0.75rem;
  }
  .ledger-caption {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.75rem;
    color: var(--muted);
  }

  /* The moving version: only on wide screens with a mouse, and only without reduced motion. */
  @media (min-width: 1024px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .ledger[data-state="pre"] .ledger-bar,
    .ledger[data-state="run"] .ledger-row:not(.is-on) .ledger-bar {
      opacity: 0;
    }
    .ledger[data-state="pre"] .ledger-bar--debit,
    .ledger[data-state="run"] .ledger-row:not(.is-on) .ledger-bar--debit {
      transform: translateX(-14px);
    }
    .ledger[data-state="pre"] .ledger-bar--credit,
    .ledger[data-state="run"] .ledger-row:not(.is-on) .ledger-bar--credit {
      transform: translateX(14px);
    }
    .ledger[data-state="pre"] .ledger-sum,
    .ledger[data-state="run"] .ledger-sum {
      opacity: 0;
    }
    .ledger-row.is-on .ledger-bar,
    .ledger[data-state="done"] .ledger-sum {
      transition:
        opacity var(--dur-page) var(--ease-out),
        transform var(--dur-page) var(--ease-out);
    }
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>("[data-ledger]");
  const motionOk = window.matchMedia(
    "(min-width: 1024px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)",
  );
  if (el) {
    if (!motionOk.matches) {
      el.dataset.state = "done";
    } else {
      const start = () => {
        el.dataset.state = "run";
        const rows = el.querySelectorAll(".ledger-row");
        rows.forEach((row, i) => window.setTimeout(() => row.classList.add("is-on"), 200 + i * 500));
        window.setTimeout(() => (el.dataset.state = "done"), 200 + rows.length * 500 + 200);
      };
      // requestIdleCallback is missing in Safari, so fall back to a short timeout there.
      const idle = (fn: () => void) => {
        if (typeof window.requestIdleCallback === "function") window.requestIdleCallback(fn, { timeout: 1500 });
        else setTimeout(fn, 300);
      };
      const afterLoad = () => window.setTimeout(() => idle(start), 600);
      if (document.readyState === "complete") afterLoad();
      else window.addEventListener("load", afterLoad, { once: true });
    }
  }
</script>
