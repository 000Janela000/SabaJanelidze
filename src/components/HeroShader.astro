---
// Direction "b-rich" only: today's hero shader (main:src/shaders/heroFragment.glsl), ported to plain WebGL
// with no three.js. Mouse-reactive like the current site.
//
// Rules it follows:
// - The hero text is real HTML and visible at once; this layer sits behind it.
// - A static CSS gradient (the same one today's site uses as its fallback) is painted first.
// - The shader starts only after the page has loaded and the browser is idle, and only on wide screens
//   with a mouse, without reduced motion, and when WebGL works. Everyone else keeps the static gradient.
// - It pauses when the hero is off-screen or the tab is hidden, and has a visible pause button
//   (WCAG 2.2.2: anything that moves by itself for more than 5 seconds needs one).
// Note: unlike every other moment on the site, it never settles to a still frame (motion rule 9).
// That is the "wow vs speed" trade-off Saba asked to compare.
---
<div class="hs" aria-hidden="true">
  <canvas class="hs-canvas" data-hero-shader></canvas>
</div>
<button type="button" class="hs-toggle" data-hero-shader-toggle hidden>Pause background</button>

<style>
  .hs {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: radial-gradient(ellipse at 30% 50%, #1a2a5e 0%, #08090d 70%);
    -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent);
    mask-image: linear-gradient(to bottom, #000 72%, transparent);
  }
  .hs-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--dur-page) var(--ease-out);
  }
  .hs-canvas.is-on {
    opacity: 1;
  }
  .hs-toggle {
    position: absolute;
    right: max(20px, calc((100% - 1180px) / 2 + 40px));
    bottom: 1.25rem;
    z-index: 1;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    color: var(--muted);
    font-size: 0.75rem;
    cursor: pointer;
  }
  .hs-toggle:hover {
    color: var(--fg);
    border-color: var(--ring);
  }
  .hs-toggle[hidden] {
    display: none;
  }
</style>

<script>
  const VERT = `attribute vec2 position;
void main() { gl_Position = vec4(position, 0.0, 1.0); }`;

  // Same as main:src/shaders/heroFragment.glsl, plus the WebGL 1 precision line.
  const FRAG = `precision mediump float;
uniform float uTime;
uniform vec2 uMouse;
uniform vec2 uResolution;
uniform vec3 uColorA;
uniform vec3 uColorB;
uniform vec3 uColorC;
vec3 mod289(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
vec2 mod289(vec2 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
vec3 permute(vec3 x) { return mod289(((x * 34.0) + 1.0) * x); }
float snoise(vec2 v) {
  const vec4 C = vec4(0.211324865405187, 0.366025403784439, -0.577350269189626, 0.024390243902439);
  vec2 i = floor(v + dot(v, C.yy));
  vec2 x0 = v - i + dot(i, C.xx);
  vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
  vec4 x12 = x0.xyxy + C.xxzz;
  x12.xy -= i1;
  i = mod289(i);
  vec3 p = permute(permute(i.y + vec3(0.0, i1.y, 1.0)) + i.x + vec3(0.0, i1.x, 1.0));
  vec3 m = max(0.5 - vec3(dot(x0, x0), dot(x12.xy, x12.xy), dot(x12.zw, x12.zw)), 0.0);
  m = m * m;
  m = m * m;
  vec3 x = 2.0 * fract(p * C.www) - 1.0;
  vec3 h = abs(x) - 0.5;
  vec3 ox = floor(x + 0.5);
  vec3 a0 = x - ox;
  m *= 1.79284291400159 - 0.85373472095314 * (a0 * a0 + h * h);
  vec3 g;
  g.x = a0.x * x0.x + h.x * x0.y;
  g.yz = a0.yz * x12.xz + h.yz * x12.yw;
  return 130.0 * dot(m, g);
}
void main() {
  vec2 uv = gl_FragCoord.xy / uResolution;
  vec2 mouseInfluence = (uMouse - 0.5) * 0.3;
  float n1 = snoise(uv * 2.0 + uTime * 0.05 + mouseInfluence);
  float n2 = snoise(uv * 4.0 - uTime * 0.03 + mouseInfluence * 0.5);
  float n3 = snoise(uv * 1.5 + uTime * 0.02);
  float noise = n1 * 0.5 + n2 * 0.3 + n3 * 0.2;
  float mixA = smoothstep(-0.5, 0.5, noise);
  float mixB = smoothstep(0.0, 1.0, n2 + 0.3);
  vec3 color = mix(uColorA, uColorB, mixA * 0.4);
  color = mix(color, uColorC, mixB * 0.15);
  float vignette = 1.0 - smoothstep(0.3, 0.9, length(uv - 0.5));
  color *= 0.85 + vignette * 0.15;
  gl_FragColor = vec4(color, 1.0);
}`;

  const canvas = document.querySelector<HTMLCanvasElement>("[data-hero-shader]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-hero-shader-toggle]");
  const allowed = window.matchMedia(
    "(min-width: 1024px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)",
  );

  const hex = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16) / 255);

  function start(c: HTMLCanvasElement) {
    const gl = c.getContext("webgl", { antialias: false, alpha: false, powerPreference: "low-power" });
    if (!gl) return; // no WebGL: the static gradient stays

    const compile = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);

    // One triangle that covers the whole canvas.
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const pos = gl.getAttribLocation(prog, "position");
    gl.enableVertexAttribArray(pos);
    gl.vertexAttribPointer(pos, 2, gl.FLOAT, false, 0, 0);

    const u = (n: string) => gl.getUniformLocation(prog, n);
    const uTime = u("uTime");
    const uMouse = u("uMouse");
    const uRes = u("uResolution");
    gl.uniform3fv(u("uColorA"), hex("#08090d"));
    gl.uniform3fv(u("uColorB"), hex("#1a2a5e"));
    gl.uniform3fv(u("uColorC"), hex("#2d1b4e"));

    let mx = 0.5;
    let my = 0.5;
    window.addEventListener(
      "pointermove",
      (e) => {
        mx = e.clientX / window.innerWidth;
        my = 1 - e.clientY / window.innerHeight;
      },
      { passive: true },
    );

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5); // same cap as today's site
      c.width = Math.round(c.clientWidth * dpr);
      c.height = Math.round(c.clientHeight * dpr);
      gl.viewport(0, 0, c.width, c.height);
      gl.uniform2f(uRes, c.width, c.height);
    };
    resize();
    new ResizeObserver(resize).observe(c);

    let raf = 0;
    let time = 0;
    let last = 0;
    let visible = true;
    let paused = false;
    const frame = (now: number) => {
      time += last ? Math.min(now - last, 100) / 1000 : 0;
      last = now;
      gl.uniform1f(uTime, time);
      gl.uniform2f(uMouse, mx, my);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      raf = requestAnimationFrame(frame);
    };
    const update = () => {
      const run = visible && !paused && !document.hidden;
      cancelAnimationFrame(raf);
      last = 0;
      if (run) raf = requestAnimationFrame(frame);
    };
    new IntersectionObserver((entries) => {
      visible = entries.some((e) => e.isIntersecting);
      update();
    }).observe(c);
    document.addEventListener("visibilitychange", update);

    if (toggle) {
      toggle.hidden = false;
      toggle.addEventListener("click", () => {
        paused = !paused;
        toggle.textContent = paused ? "Play background" : "Pause background";
        update();
      });
    }
    update();
    requestAnimationFrame(() => c.classList.add("is-on"));
  }

  if (canvas && allowed.matches) {
    const begin = () =>
      setTimeout(() => {
        if (typeof window.requestIdleCallback === "function") window.requestIdleCallback(() => start(canvas), { timeout: 2000 });
        else setTimeout(() => start(canvas), 300);
      }, 300);
    if (document.readyState === "complete") begin();
    else window.addEventListener("load", begin, { once: true });
  }
</script>
