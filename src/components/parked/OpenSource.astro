---
// PARKED (Phase 1c, 2026-10-15): not on the home page any more. Kept for the future "How I work" page and case studies.
// It uses the notebook building blocks, so it loads notebook.css itself.
import "../../styles/notebook.css";
// §5 Open source: three tools with their install command.
import Section from "./NotebookSection.astro";
import { openSource } from "../../content/home";
---
<Section id="open-source" num="§5" label="open source" heading={openSource.heading}>
  <p class="os-dl">
    <strong class="nb-mono tabular">{openSource.downloads}</strong>{" "}<span>({openSource.downloadsNote})</span>
  </p>
  <ul class="os-list">
    {
      openSource.items.map((o) => (
        <li class="os-row">
          <div>
            <h3 class="os-name">
              <a class="nb-link" href={o.href} rel="noopener">
                {o.name}
              </a>
            </h3>
            <p class="nb-mono os-kind">{o.kind}</p>
          </div>
          <p class="os-text">{o.text}</p>
          <code class="os-cmd">
            <span aria-hidden="true">$ </span>
            {o.install}
          </code>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .os-dl {
    margin: 0 0 var(--space-6);
    color: var(--muted);
  }
  .os-dl strong {
    color: var(--accent);
    font-weight: var(--weight-regular);
    font-size: var(--fs-lg);
  }
  .os-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }
  .os-row {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .os-row {
      grid-template-columns: 220px minmax(0, 1fr) 300px;
      gap: var(--space-6);
      align-items: start;
    }
  }
  .os-name {
    margin: 0 0 0.2rem;
    font-size: var(--fs-lg);
    font-weight: var(--weight-strong);
  }
  .os-kind {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .os-text {
    margin: 0;
    color: var(--muted);
  }
  .os-cmd {
    display: block;
    overflow-x: auto;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-tag);
    background: var(--surface-2);
    font-family: var(--font-code);
    font-size: 0.8125rem;
    white-space: nowrap;
  }
  .os-cmd span {
    color: var(--muted);
  }
</style>
