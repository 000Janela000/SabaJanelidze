---
// PARKED (Phase 1c, 2026-10-15): the WebGL glow is not used anywhere any more (Saba: no glow). Kept only for a possible
// future Playground page; it needs the removed --hero-glow tokens back before it can be used.
// The hero background in the Blueprint (dark) theme. Invisible in Paper (--hero-glow: 0).
// 1. Everyone in Blueprint gets a static blue glow (CSS gradient, 0 KB of JavaScript), phones included.
// 2. On desktop only (wide screen, mouse), without reduced motion, the glow comes alive: after the page
//    has loaded and the browser is idle, src/lib/blueprint-gl.ts is downloaded (about 2 KB) and draws
//    a slow WebGL glow on top. It settles to a still frame when the visitor is quiet, pauses off-screen
//    and in hidden tabs, and has a "Pause background" button. Switching to Paper stops it at once.
// The hero text never waits for any of this: it is plain HTML above this layer.
---
<div class="bg-glow" aria-hidden="true">
  <canvas class="bg-glow-canvas" data-glow></canvas>
</div>
<button type="button" class="bg-glow-btn" data-glow-btn hidden>Pause background</button>

<style>
  .bg-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    opacity: var(--hero-glow);
    background: radial-gradient(48% 62% at 30% 48%, var(--hero-glow-color), transparent 72%);
    -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent);
    mask-image: linear-gradient(to bottom, #000 70%, transparent);
  }
  .bg-glow-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
  }
  .bg-glow-canvas:global(.is-on) {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .bg-glow-canvas {
      transition: opacity 400ms var(--ease-out);
    }
  }
  .bg-glow-btn {
    position: absolute;
    right: max(var(--gutter), calc((100% - var(--content-max)) / 2 + var(--gutter)));
    bottom: var(--space-4);
    z-index: 1;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--muted);
    font-family: var(--font-code);
    font-size: var(--fs-xs);
    cursor: pointer;
  }
  .bg-glow-btn:hover {
    color: var(--fg);
    border-color: var(--faint);
  }
  .bg-glow-btn[hidden] {
    display: none;
  }
</style>

<script>
  import type { Glow } from "../../lib/blueprint-gl";

  const canvas = document.querySelector<HTMLCanvasElement>("[data-glow]");
  const button = document.querySelector<HTMLButtonElement>("[data-glow-btn]");
  const root = document.documentElement;
  const desktop = window.matchMedia(
    "(min-width: 1024px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)",
  );
  const dark = window.matchMedia("(prefers-color-scheme: dark)");
  const blueprint = () => {
    const t = root.getAttribute("data-theme");
    return t ? t === "blueprint" : dark.matches;
  };

  let glow: Glow | null = null;
  let loading = false;
  let ready = false; // page loaded and browser idle

  function check() {
    if (!canvas || !ready) return;
    const want = desktop.matches && blueprint();
    if (!want) {
      glow?.stop();
      return;
    }
    if (glow) {
      glow.start();
      return;
    }
    if (loading) return;
    loading = true;
    import("../../lib/blueprint-gl")
      .then((m) => {
        glow = m.mount(canvas, button);
        if (glow && desktop.matches && blueprint()) glow.start();
      })
      .catch(() => {
        // No WebGL or the file failed to load: the static glow stays. Nothing else depends on it.
      });
  }

  if (canvas) {
    const begin = () =>
      window.setTimeout(() => {
        const go = () => {
          ready = true;
          check();
        };
        if (typeof window.requestIdleCallback === "function") window.requestIdleCallback(go, { timeout: 2000 });
        else window.setTimeout(go, 300);
      }, 300);
    if (document.readyState === "complete") begin();
    else window.addEventListener("load", begin, { once: true });
    window.addEventListener("themechange", check);
    dark.addEventListener("change", check);
    desktop.addEventListener("change", check);
  }
</script>
