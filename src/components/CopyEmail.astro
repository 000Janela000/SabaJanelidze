---
// Signature moment 6 (micro-feedback): a "Copy" button next to the email address that turns into "Copied"
// for 1.5 s. A text swap, not an animation, so it stays for visitors who prefer reduced motion.
// Hidden without JavaScript (the mailto link still works).
import { contact } from "../content/home";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<button type="button" class:list={["copy-email", className]} data-copy={contact.email} data-copied={contact.copy.copied} data-failed={contact.copy.failed} aria-label={contact.copy.label} hidden>
  <span data-idle>{contact.copy.idle}</span>
  <span data-done hidden>{contact.copy.done}{" "}<span aria-hidden="true">✓</span></span>
</button>
<span class="sr-only" role="status" aria-atomic="true" data-copy-status></span>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    if (!navigator.clipboard) continue;
    btn.hidden = false;
    const idle = btn.querySelector<HTMLElement>("[data-idle]");
    const done = btn.querySelector<HTMLElement>("[data-done]");
    // The status line sits right after the button; screen readers announce its text.
    const status = btn.nextElementSibling as HTMLElement | null;
    const say = (text: string) => {
      if (status?.hasAttribute("data-copy-status")) status.textContent = text;
    };
    let timer = 0;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
      } catch {
        say(btn.dataset.failed ?? "");
        return;
      }
      say(btn.dataset.copied ?? "");
      if (idle) idle.hidden = true;
      if (done) done.hidden = false;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (idle) idle.hidden = false;
        if (done) done.hidden = true;
      }, 1500);
    });
  }
</script>
