---
// The hero: complete without JavaScript (motion rule 1). Name, title, pitch, proof line, the two paths
// (Book a call / For hiring managers), and fig. 1. In Blueprint, a calm glow sits behind it.
import BlueprintGlow from "./BlueprintGlow.astro";
import GreenTestsFigure from "./GreenTestsFigure.astro";
import { hero } from "../../content/home";
---
<section class="hero" aria-labelledby="hero-title">
  <BlueprintGlow />
  <div class="nb-wrap hero-in">
    <div class="hero-text">
      <p class="nb-mono hero-kicker">{hero.kicker}</p>
      <h1 id="hero-title" class="hero-name">{hero.name}</h1>
      <p class="hero-title">{hero.title}</p>
      <p class="hero-pitch">{hero.pitch}</p>
      {/* DRAFT proof line for Saba's approval. */}
      <ul class="hero-proof" aria-label="In short">
        {hero.proof.map((p) => <li>{p}</li>)}
      </ul>
      <div class="hero-actions">
        <a class="nb-btn" href={hero.cta.href}>{hero.cta.label}</a>
        <a class="nb-link hero-hiring" href={hero.hiring.href}>{hero.hiring.label}{" "}<span aria-hidden="true">→</span></a>
      </div>
    </div>
    <GreenTestsFigure />
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
  }
  .hero-in {
    display: grid;
    gap: var(--space-7);
    padding-top: var(--space-7);
    padding-bottom: var(--space-7);
  }
  @media (min-width: 1024px) {
    .hero-in {
      grid-template-columns: minmax(0, 11fr) minmax(0, 9fr);
      align-items: center;
      gap: var(--space-8);
      padding-top: 2.5rem;
      padding-bottom: 3rem;
    }
  }
  .hero-kicker {
    margin: 0 0 var(--space-4);
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .hero-name {
    margin: 0;
    font-size: var(--fs-4xl);
    font-weight: var(--weight-strong);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-display);
  }
  .hero-title {
    margin: var(--space-3) 0 var(--space-5);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--line-strong);
    font-size: var(--fs-lg);
    font-weight: var(--weight-strong);
    color: var(--accent);
  }
  .hero-pitch {
    max-width: 27em;
    margin: 0 0 var(--space-5);
    font-size: var(--fs-xl);
    line-height: 1.42;
    text-wrap: pretty;
  }
  .hero-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0;
    margin: 0 0 var(--space-6);
    padding: 0.65rem 0.95rem;
    list-style: none;
    border-left: 3px solid var(--accent);
    background: var(--surface);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .hero-proof li:first-child {
    flex-basis: 100%;
    color: var(--fg);
    font-weight: var(--weight-strong);
  }
  .hero-proof li:nth-child(3)::before {
    content: "·";
    margin: 0 0.5rem;
    color: var(--faint);
  }
  @media (max-width: 639px) {
    .hero-proof {
      display: grid;
    }
    .hero-proof li:nth-child(3)::before {
      content: none;
    }
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
  }
  .hero-hiring {
    font-weight: var(--weight-strong);
  }
</style>
