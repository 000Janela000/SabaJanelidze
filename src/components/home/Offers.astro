---
// What I do: the three offers, short. Three columns on desktop, a plain list with hairlines on phones.
import Section from "../site/Section.astro";
import { offers } from "../../content/home";
---
<Section id="services" heading={offers.heading} intro={offers.intro}>
  <ul class="of">
    {
      offers.items.map((o) => (
        <li class="of-item">
          <h3 class="of-title">{o.title}</h3>
          <p class="of-text">{o.text}</p>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .of {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 900px) {
    .of {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
  .of-item {
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .of-title {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-lg);
    font-weight: var(--weight-strong);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .of-text {
    margin: 0;
    color: var(--muted);
  }
</style>
