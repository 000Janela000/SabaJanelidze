---
// Selected work, right after the hero. Outcome first on every card.
// Bitnet: a wide card (image left, text right on desktop). PlayTime and WasteAway: two cards side by side.
// Chama and UniHub: short text-only cards (UniHub's only public page is a sign-in screen, which looks empty
// as a thumbnail; Chama has no image either, so the two small cards match).
// Images are screenshots of public pages only.
import Section from "../site/Section.astro";
import { work } from "../../content/home";

const [lead, ...rest] = work.big;
const host = (url: string) => url.replace("https://", "");
---
<Section id="work" heading={work.heading}>
  <div class="wk">
    {
      [lead, ...rest].map((w, i) => (
        <article class:list={["ui-card wk-card", { "wk-card--lead": i === 0 }]} id={`work-${w.slug}`} aria-labelledby={`work-${w.slug}-title`}>
          <div class="wk-media">
            <img
              src={w.image.src}
              width={w.image.width}
              height={w.image.height}
              alt={w.image.alt}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="wk-body">
            <p class="ui-meta">
              {w.role}
              {w.years && <span class="tabular">{" · "}{w.years}</span>}
            </p>
            <h3 id={`work-${w.slug}-title`} class="wk-title">
              {w.title}
            </h3>
            <p class="wk-outcome">{w.outcome}</p>
            <p class="wk-text">{w.text}</p>
            <p class="wk-links">
              {w.url && (
                <a class="ui-link" href={w.url} rel="noopener">
                  {host(w.url)}
                  <span aria-hidden="true">{" ↗"}</span>
                </a>
              )}
              {w.note && <span class="ui-meta">{w.note}</span>}
            </p>
          </div>
        </article>
      ))
    }
  </div>

  <div class="wk-small">
    {
      work.small.map((w) => (
        <article class="wk-mini" id={`work-${w.slug}`} aria-labelledby={`work-${w.slug}-title`}>
          <p class="ui-meta">
            {w.role}
            {w.years && <span>{" · "}{w.years}</span>}
          </p>
          <h3 id={`work-${w.slug}-title`} class="wk-mini-title">
            {w.title}
          </h3>
          <p class="wk-mini-text">{w.outcome}</p>
        </article>
      ))
    }
  </div>
</Section>

<style>
  .wk {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 900px) {
    .wk {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-6);
    }
  }
  .wk-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  @media (min-width: 900px) {
    .wk-card--lead {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
  .wk-media {
    padding: var(--space-3) var(--space-3) 0;
  }
  @media (min-width: 900px) {
    .wk-media {
      padding: var(--space-4) var(--space-4) 0;
    }
    .wk-card--lead .wk-media {
      padding: var(--space-4);
    }
  }
  .wk-media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius-card) - 4px);
    background: var(--surface-2);
  }
  @media (min-width: 900px) {
    .wk-card--lead .wk-media img {
      aspect-ratio: 16 / 10;
    }
  }
  .wk-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--space-4) var(--space-5) var(--space-5);
  }
  @media (min-width: 900px) {
    .wk-body {
      padding: var(--space-5) var(--space-6) var(--space-6);
    }
    .wk-card--lead .wk-body {
      justify-content: center;
      padding-left: var(--space-4);
    }
  }
  .wk-title {
    margin: var(--space-1) 0 var(--space-3);
    font-size: var(--fs-xl);
    font-weight: var(--weight-strong);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-heading);
  }
  .wk-outcome {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-lg);
    line-height: 1.45;
  }
  .wk-text {
    margin: 0;
    color: var(--muted);
  }
  .wk-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
    margin: var(--space-4) 0 0;
  }
  @media (min-width: 900px) {
    .wk-card:not(.wk-card--lead) .wk-links {
      margin-top: auto;
      padding-top: var(--space-4);
    }
  }

  .wk-small {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-7);
  }
  @media (min-width: 768px) {
    .wk-small {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-6);
    }
  }
  .wk-mini {
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .wk-mini-title {
    margin: var(--space-1) 0 var(--space-1);
    font-size: var(--fs-lg);
    font-weight: var(--weight-strong);
    line-height: var(--lh-heading);
  }
  .wk-mini-text {
    margin: 0;
    color: var(--muted);
  }
</style>
