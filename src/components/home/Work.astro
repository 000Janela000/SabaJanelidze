---
// §3 Selected work: three big project cards (image, one-line outcome, 2-3 tags), then two small ones.
// Images are screenshots of public pages only.
import Section from "../site/Section.astro";
import { work } from "../../content/home";
---
<Section id="work" num="§3" label="work" heading={work.heading} intro={work.intro}>
  <div class="wk-big">
    {
      work.big.map((w, i) => (
        <article class="nb-card wk-card" id={`work-${w.slug}`} aria-labelledby={`work-${w.slug}-title`}>
          <figure class="wk-fig">
            <img
              src={w.image.src}
              width={w.image.width}
              height={w.image.height}
              alt={w.image.alt}
              loading="lazy"
              decoding="async"
            />
            <figcaption class="nb-mono wk-figcap">
              fig. 4{String.fromCharCode(97 + i)} — {w.image.alt.replace(/^The /, "the ")}
              {w.image.taken && <span>{`, ${w.image.taken}`}</span>}
            </figcaption>
          </figure>
          <div class="wk-body">
            <p class="nb-mono wk-meta">
              {w.role}
              {w.years && <span class="tabular">{" · "}{w.years}</span>}
            </p>
            <h3 id={`work-${w.slug}-title`} class="wk-title">
              {w.title}
            </h3>
            <p class="wk-outcome">{w.outcome}</p>
            <p class="wk-text">{w.text}</p>
            <ul class="nb-tags" aria-label="Tags">
              {w.tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
            <p class="wk-links">
              {w.url && (
                <a class="nb-link" href={w.url} rel="noopener">
                  {w.url.replace("https://", "")}
                  <span aria-hidden="true">{" ↗"}</span>
                </a>
              )}
              {w.note && <span class="nb-note">{w.note}</span>}
            </p>
          </div>
        </article>
      ))
    }
  </div>

  <div class="wk-small">
    {
      work.small.map((w) => (
        <article class="nb-card wk-mini" id={`work-${w.slug}`} aria-labelledby={`work-${w.slug}-title`}>
          <img
            src={w.image.src}
            width={w.image.width}
            height={w.image.height}
            alt={w.image.alt}
            loading="lazy"
            decoding="async"
          />
          <div>
            <p class="nb-mono wk-meta">
              {w.role}
              {w.years && <span>{" · "}{w.years}</span>}
            </p>
            <h3 id={`work-${w.slug}-title`} class="wk-mini-title">
              {w.title}
            </h3>
            <p class="wk-mini-outcome">{w.outcome}</p>
            <ul class="nb-tags" aria-label="Tags">
              {w.tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</Section>

<style>
  .wk-big {
    display: grid;
    gap: var(--space-6);
  }
  .wk-card {
    display: grid;
    overflow: hidden;
  }
  @media (min-width: 900px) {
    .wk-card {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
  .wk-fig {
    margin: 0;
    padding: var(--space-4);
    border-bottom: 1px solid var(--line);
    background: var(--surface-2);
  }
  @media (min-width: 900px) {
    .wk-fig {
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }
  }
  .wk-fig img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-tag);
    background: var(--surface);
  }
  .wk-figcap {
    margin-top: var(--space-2);
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .wk-body {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
  }
  @media (min-width: 900px) {
    .wk-body {
      padding: var(--space-6);
    }
  }
  .wk-meta {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .wk-title {
    margin: 0 0 var(--space-4);
    font-size: var(--fs-2xl);
    font-weight: var(--weight-strong);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-heading);
  }
  .wk-outcome {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-3);
    border-left: 2px solid var(--accent);
    font-size: var(--fs-lg);
    font-weight: var(--weight-strong);
    line-height: 1.4;
  }
  .wk-text {
    margin: 0 0 var(--space-5);
    color: var(--muted);
  }
  .wk-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
    margin: var(--space-5) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .wk-links {
      margin-top: auto;
    }
    .wk-body .nb-tags {
      margin-bottom: var(--space-5);
    }
  }

  .wk-small {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
  @media (min-width: 768px) {
    .wk-small {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-5);
    }
  }
  .wk-mini {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
    padding: var(--space-5);
  }
  @media (max-width: 479px) {
    .wk-mini {
      grid-template-columns: 1fr;
    }
  }
  .wk-mini img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--line);
    border-radius: var(--radius-tag);
  }
  .wk-mini-title {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-lg);
    font-weight: var(--weight-strong);
  }
  .wk-mini-outcome {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-sm);
    color: var(--muted);
  }
</style>
