---
// Contact: "Email me" (a plain mailto link), the address with Copy, LinkedIn and GitHub.
import Section from "../site/Section.astro";
import CopyEmail from "../CopyEmail.astro";
import { contact } from "../../content/home";
---
<Section id="contact" heading={contact.heading} intro={contact.text}>
  <div class="ct-actions">
    <a class="ui-btn" href={contact.cta.href}>{contact.cta.label}</a>
    <span class="ct-email">
      <a class="ui-link" href={`mailto:${contact.email}`}>{contact.email}</a>
      <CopyEmail class="ct-copy" />
    </span>
  </div>
  <p class="ct-links">
    {
      contact.links.map((l) => (
        <a class="ui-link" href={l.href} rel="noopener me">
          {l.label}
        </a>
      ))
    }
  </p>
</Section>

<style>
  .ct-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
  }
  .ct-email {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-md);
  }
  .ct-email :global(.ct-copy) {
    min-height: 36px;
    padding: 0 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-size: var(--fs-sm);
    cursor: pointer;
  }
  .ct-email :global(.ct-copy:hover) {
    background: var(--surface-2);
  }
  .ct-links {
    display: flex;
    gap: var(--space-5);
    margin: var(--space-5) 0 0;
  }
</style>
