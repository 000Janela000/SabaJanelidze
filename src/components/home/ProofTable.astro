---
// table 1: numbers I can point to. Each one is true, dated and sourced.
import { proof } from "../../content/home";
---
<section class="nb-wrap pt" aria-labelledby="table1-cap">
  <p id="table1-cap" class="pt-cap">
    <span class="nb-cap-num">table 1</span> — <strong>Numbers I can point to.</strong> Each one is dated and has a source.
  </p>
  <ul class="pt-list">
    {
      proof.map((p) => (
        <li class="pt-row">
          <span class="pt-org">{p.org}</span>
          <a class="pt-value nb-mono tabular" href={p.href}>
            {p.value}
          </a>
          <span class="pt-label">
            {p.label}
            {p.detail && <span class="pt-detail">{p.detail}</span>}
          </span>
          <span class="pt-source nb-mono">{p.source}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .pt-cap {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .pt-cap strong {
    color: var(--fg);
  }
  .pt-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    background: var(--surface);
  }
  .pt-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.1rem var(--space-4);
    padding: var(--space-4) var(--space-4);
    border-bottom: 1px solid var(--line);
  }
  .pt-row:last-child {
    border-bottom: 0;
  }
  .pt-org {
    font-weight: var(--weight-strong);
  }
  .pt-source {
    grid-column: 2;
    grid-row: 1;
    align-self: center;
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .pt-value {
    grid-column: 1 / -1;
    justify-self: start;
    font-size: 1.75rem;
    line-height: 1.3;
    color: var(--accent);
    text-decoration: none;
  }
  .pt-value:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }
  .pt-label {
    grid-column: 1 / -1;
  }
  .pt-detail {
    display: block;
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  @media (min-width: 900px) {
    .pt-row {
      grid-template-columns: 120px 180px minmax(0, 1fr) 190px;
      align-items: baseline;
      padding: var(--space-4) var(--space-5);
    }
    .pt-org,
    .pt-value,
    .pt-label,
    .pt-source {
      grid-column: auto;
      grid-row: auto;
    }
    .pt-value {
      font-size: 1.875rem;
    }
    .pt-detail {
      display: inline;
    }
    .pt-detail::before {
      content: " · ";
    }
    .pt-source {
      align-self: baseline;
      text-align: right;
    }
  }
</style>
