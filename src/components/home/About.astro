---
// About: the portrait, two paragraphs, the stack (grouped) and the open-source tools, one line each with its
// proof number (Phase 1e, Phase 1d fix 8). The portrait is larger and square, straight on the page colour
// (no card, no border); Saba will send a better photo later, the file stays the same until then.
import Section from "../site/Section.astro";
import { about } from "../../content/home";
---
<Section id="about" heading={about.heading}>
  <div class="ab">
    <img class="ab-portrait" src="/portrait.webp" width="800" height="800" alt={about.portraitAlt} loading="lazy" decoding="async" />
    <div class="ab-text">
      {about.bio.map((b) => <p class="ab-p">{b}</p>)}

      <h3 class="ab-h3">{about.openSource.label}</h3>
      <ul class="ab-os">
        {
          about.openSource.items.map((o) => (
            <li>
              <a class="ui-link ab-os-name" href={o.href} rel="noopener">{o.name}</a>{`: ${o.text}. `}<span class="ab-os-proof">{o.proof}.</span>
            </li>
          ))
        }
      </ul>
      <p class="ab-note ui-source">{about.openSource.note}</p>

      <h3 class="ab-h3">Stack</h3>
      <dl class="ab-stack">
        {
          about.stack.map((g) => (
            <div>
              <dt>{g.group}</dt>
              <dd>{g.items.join(", ")}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</Section>

<style>
  /* Phones: a square portrait beside the first paragraph (the text flows around it). Desktop: two columns. */
  .ab::after {
    content: "";
    display: table;
    clear: both;
  }
  .ab-portrait {
    float: left;
    width: 128px;
    height: auto;
    margin: 0.35rem var(--space-4) var(--space-2) 0;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: 50% 50%;
    border-radius: var(--radius);
  }
  @media (min-width: 900px) {
    .ab {
      display: grid;
      grid-template-columns: 280px minmax(0, 1fr);
      gap: var(--space-8);
      align-items: start;
    }
    .ab::after {
      content: none;
    }
    .ab-portrait {
      float: none;
      width: 100%;
      margin: 0;
    }
  }
  .ab-p {
    max-width: 38em;
    margin: 0 0 var(--space-4);
    font-size: var(--fs-md);
  }
  .ab-p + .ab-p {
    color: var(--muted);
  }
  .ab-h3 {
    clear: both;
    margin: var(--space-6) 0 var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    font-size: var(--fs-sm);
    font-weight: var(--weight-strong);
    line-height: 1.4;
  }
  .ab-os {
    display: grid;
    gap: var(--space-3);
    max-width: 44em;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--muted);
  }
  .ab-os-name {
    font-weight: var(--weight-strong);
  }
  .ab-os-proof {
    color: var(--fg);
  }
  .ab-note {
    margin: var(--space-3) 0 0;
  }
  .ab-stack {
    display: grid;
    gap: var(--space-2);
    max-width: 44em;
    margin: 0;
  }
  .ab-stack > div {
    display: grid;
    gap: 0.1rem;
  }
  @media (min-width: 640px) {
    .ab-stack > div {
      grid-template-columns: 9.5rem minmax(0, 1fr);
      gap: var(--space-4);
    }
  }
  .ab-stack dt {
    font-size: var(--fs-sm);
    color: var(--fg);
    line-height: 1.6;
  }
  .ab-stack dd {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--muted);
  }
</style>
