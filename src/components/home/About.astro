---
// About, short: portrait, two paragraphs, the stack and the open-source tools in one line each.
import Section from "../site/Section.astro";
import { about } from "../../content/home";
---
<Section id="about" heading={about.heading}>
  <div class="ab">
    <img class="ab-portrait" src="/portrait.webp" width="844" height="1088" alt={about.portraitAlt} loading="lazy" decoding="async" />
    <div class="ab-text">
      {about.bio.map((b) => <p class="ab-p">{b}</p>)}
      <dl class="ab-facts">
        {
          about.facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.text}</dd>
            </div>
          ))
        }
        <div>
          <dt>{about.openSource.label}</dt>
          <dd>
            {about.openSource.items.map((o, i) => (
              <span>
                <a class="ui-link" href={o.href} rel="noopener">{o.name}</a>{" "}({o.text}){i < about.openSource.items.length - 1 ? ", " : ""}
              </span>
            ))}
          </dd>
        </div>
      </dl>
    </div>
  </div>
</Section>

<style>
  /* Phones: a small portrait beside the first paragraph (the text flows around it). Desktop: two columns. */
  .ab::after {
    content: "";
    display: table;
    clear: both;
  }
  .ab-portrait {
    float: left;
    width: 96px;
    height: auto;
    margin: 0.35rem var(--space-4) var(--space-2) 0;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface-2);
  }
  @media (min-width: 900px) {
    .ab {
      display: grid;
      grid-template-columns: 220px minmax(0, 1fr);
      gap: var(--space-8);
      align-items: start;
    }
    .ab::after {
      content: none;
    }
    .ab-portrait {
      float: none;
      width: 100%;
      margin: 0;
    }
  }
  .ab-p {
    max-width: 38em;
    margin: 0 0 var(--space-4);
    font-size: var(--fs-md);
  }
  .ab-p + .ab-p {
    color: var(--muted);
  }
  .ab-facts {
    clear: both;
    display: grid;
    gap: var(--space-3);
    max-width: 44em;
    margin: var(--space-5) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .ab-facts > div {
    display: grid;
    gap: 0.1rem;
  }
  @media (min-width: 640px) {
    .ab-facts > div {
      grid-template-columns: 8.5rem minmax(0, 1fr);
      gap: var(--space-4);
    }
  }
  .ab-facts dt {
    font-size: var(--fs-sm);
    font-weight: var(--weight-strong);
    color: var(--fg);
    line-height: 1.6;
  }
  .ab-facts dd {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--muted);
  }
</style>
