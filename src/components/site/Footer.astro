---
// The site footer: build receipt (placeholder), "For hiring managers", language switch, copyright.
import { footer } from "../../content/home";
---
<footer class="ft">
  <div class="nb-wrap ft-row">
    <p class="ft-receipt nb-mono">{footer.receipt}</p>
    <p class="ft-links">
      <a href={footer.hiring.href}>{footer.hiring.label}</a>
      <span class="ft-lang nb-mono">
        <a href={footer.lang.en.href} aria-current="page">EN</a>
        <span aria-hidden="true">/</span>
        <a href={footer.lang.ka.href} lang="ka">KA</a>
      </span>
      <span>{footer.copyright}</span>
    </p>
  </div>
</footer>

<style>
  .ft {
    margin-top: var(--section-space);
    border-top: 1px solid var(--line-strong);
    background: var(--bg);
  }
  .ft-row {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-6);
    padding-bottom: var(--space-7);
    font-size: 0.8125rem;
    color: var(--muted);
  }
  @media (min-width: 900px) {
    .ft-row {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-7);
    }
  }
  .ft a {
    color: inherit;
    text-decoration: none;
  }
  .ft-receipt {
    margin: 0;
    max-width: 60em;
    font-size: var(--fs-xs);
  }
  .ft-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    margin: 0;
  }
  .ft-links > a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ft-links > a:hover,
  .ft-lang a:hover {
    color: var(--fg);
  }
  .ft-lang {
    display: inline-flex;
    gap: 0.35rem;
  }
  .ft-lang a {
    display: inline-block;
    padding: 0.4rem 0.2rem;
  }
  .ft-lang a[aria-current="page"] {
    color: var(--fg);
    font-weight: var(--weight-strong);
  }
</style>
