---
// One home-page section of the calm design: a heading, an optional intro line, then the content (the slot).
// No numbers, no labels, no rules: space separates the sections.
interface Props {
  id: string;
  heading: string;
  intro?: string;
  class?: string;
}
const { id, heading, intro, class: className } = Astro.props;
---
<section class:list={["ui-section", className]} id={id} aria-labelledby={`${id}-title`}>
  <div class="ui-wrap">
    <h2 id={`${id}-title`} class="ui-h2">{heading}</h2>
    {intro && <p class="ui-intro">{intro}</p>}
    <div class="ui-section-body">
      <slot />
    </div>
  </div>
</section>
