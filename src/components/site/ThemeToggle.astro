---
// The Paper / Blueprint switch in the header.
// - A real <button> with aria-pressed: "Dark theme (Blueprint), toggle button, pressed / not pressed".
// - Hidden without JavaScript (it could not work); the page then follows the system setting.
// - The choice is remembered in localStorage (key "theme"); if storage is blocked it still works for this page.
// - The switch is revealed in a growing circle from the button (View Transitions, clip-path, 400 ms)
//   when the browser supports it and the visitor has not asked for reduced motion. Keyboard use switches
//   instantly (motion rule 5). A second click skips the running reveal (motion rule 7).
// - Other scripts (the blueprint glow) listen for the "themechange" event on window.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<button
  type="button"
  class:list={["tt", className]}
  data-theme-toggle
  aria-pressed="false"
  aria-label="Dark theme (Blueprint)"
  title="Switch between Paper (light) and Blueprint (dark)"
>
  <svg class="tt-icon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
    <rect x="2.5" y="2.5" width="15" height="15" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
    <path d="M17.5 2.5 L2.5 17.5 L17.5 17.5 Z" fill="currentColor"></path>
  </svg>
</button>

<style>
  .tt {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--fg);
    cursor: pointer;
  }
  :global(html.js) .tt {
    display: inline-flex;
  }
  .tt:hover {
    border-color: var(--fg);
  }
  /* The icon turns half a circle to show the state. */
  .tt-icon {
    display: block;
  }
  .tt[aria-pressed="true"] .tt-icon {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .tt-icon {
      transition: transform var(--dur-fast) var(--ease-out);
    }
  }
</style>

<script>
  type Theme = "paper" | "blueprint";
  const root = document.documentElement;
  const dark = window.matchMedia("(prefers-color-scheme: dark)");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  const COLOR: Record<Theme, string> = { paper: "#f5f3ec", blueprint: "#0a0b0e" };
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]"));

  const current = (): Theme => {
    const t = root.getAttribute("data-theme");
    return t === "paper" || t === "blueprint" ? t : dark.matches ? "blueprint" : "paper";
  };

  function sync() {
    const t = current();
    for (const b of buttons) b.setAttribute("aria-pressed", String(t === "blueprint"));
    if (root.hasAttribute("data-theme"))
      for (const m of document.querySelectorAll('meta[name="theme-color"]')) m.setAttribute("content", COLOR[t]);
  }

  function apply(t: Theme) {
    root.setAttribute("data-theme", t);
    try {
      localStorage.setItem("theme", t);
    } catch {
      // Storage blocked: the choice lasts for this page only.
    }
    sync();
    window.dispatchEvent(new CustomEvent("themechange", { detail: t }));
  }

  let running: ViewTransition | null = null;

  for (const b of buttons) {
    b.addEventListener("click", (e) => {
      const next: Theme = current() === "blueprint" ? "paper" : "blueprint";
      running?.skipTransition();
      const keyboard = e.detail === 0;
      if (typeof document.startViewTransition !== "function" || reduce.matches || keyboard) {
        apply(next);
        return;
      }
      const r = b.getBoundingClientRect();
      const x = r.left + r.width / 2;
      const y = r.top + r.height / 2;
      const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
      root.classList.add("theme-vt");
      const vt = document.startViewTransition(() => apply(next));
      running = vt;
      vt.ready
        .then(() => {
          root.animate(
            { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
            { duration: 400, easing: "cubic-bezier(0.2, 0.8, 0.2, 1)", pseudoElement: "::view-transition-new(root)" },
          );
        })
        .catch(() => {});
      const done = () => {
        if (running !== vt) return; // a newer switch owns the class now
        running = null;
        root.classList.remove("theme-vt");
      };
      vt.finished.then(done, done);
    });
  }

  // No choice made yet: follow the system when it changes.
  dark.addEventListener("change", () => {
    if (root.hasAttribute("data-theme")) return;
    sync();
    window.dispatchEvent(new CustomEvent("themechange", { detail: current() }));
  });

  sync();
</script>
