---
// Direction B, "Today's dark identity, made light and fast": the current site's dark palette and blue accent,
// none of its heavy effects (no preloader, shader, cursor, smooth scroll, tilt, marquee, letter splitting).
// One quiet accent: the "balanced ledger" beside the hero (desktop only, settles after ~4 s).
//
// lang="ka" renders only the hero + What I do + a typography sample, using ONLY Georgian strings that were
// already approved on the old site (src/content/ka-approved.ts). Everything else stays English, marked with
// a dashed outline (data-fb) and lang="en".
import Pipeline from "../../components/Pipeline.astro";
import CopyEmail from "../../components/CopyEmail.astro";
import LedgerAccent from "../../components/LedgerAccent.astro";
import HeroShader from "../../components/HeroShader.astro";
import {
  hero,
  nav,
  proof,
  offers,
  pipeline,
  work,
  game,
  ask,
  openSource,
  about,
  contact,
  footer,
} from "../../content/home";
import { kaApproved, kaTypographySample } from "../../content/ka-approved";

interface Props {
  lang?: "en" | "ka";
  /** "b-rich": add today's WebGL hero shader behind the hero (desktop only). Everything else is identical. */
  rich?: boolean;
}
const { lang = "en", rich = false } = Astro.props;
const ka = lang === "ka";
// Marks English text on the Georgian page: no approved Georgian exists for it yet.
const fb = ka ? { lang: "en", "data-fb": "" } : {};

const navKa: Record<string, string | undefined> = {
  "#work": kaApproved.nav.work,
  "#about": kaApproved.nav.about,
};
const enPage = rich ? "/design/b-rich" : "/design/b";
const kaPage = "/ka/design/b";
---
<div id="top">
  <header class="db-header">
    <div class="db-wrap db-header-row">
      <a class="db-logo" href="#top">{ka ? kaApproved.name : hero.name}</a>
      <nav class="db-nav" aria-label="Main">
        {
          nav.map((n) => {
            const label = ka ? navKa[n.href] : n.label;
            const href = ka ? enPage + n.href : n.href;
            return label ? (
              <a href={href}>{label}</a>
            ) : (
              <a href={href} {...fb}>
                {n.label}
              </a>
            );
          })
        }
      </nav>
      <div class="db-header-end">
        <a class="db-btn db-btn--sm" href={ka ? enPage + "#contact" : hero.cta.href} {...fb}>{hero.cta.label}</a>
        <span class="db-lang">
          <a href={enPage} aria-current={ka ? undefined : "page"} lang="en">EN</a>
          <a href={kaPage} aria-current={ka ? "page" : undefined} lang="ka">KA</a>
        </span>
      </div>
    </div>
  </header>

  <main id="main" tabindex="-1">
    {
      ka && (
        <p class="db-wrap db-legend" lang="en">
          Georgian check (Phase 1): only Georgian that was already approved on the current site is used.
          Text with a <span data-fb>dashed outline</span> is still English, because no approved Georgian exists yet.
        </p>
      )
    }
    <div class="db-hero-shell">
    {rich && <HeroShader />}
    <section class="db-wrap db-hero" aria-labelledby="hero-title">
      <div class="db-hero-text">
        <h1 id="hero-title" class="db-hero-name">{ka ? kaApproved.name : hero.name}</h1>
        <p class="db-hero-title">
          {
            ka ? (
              <>
                <span lang="en">{kaApproved.title}</span>
                <span {...fb}>{" · Fintech & AI"}</span>
              </>
            ) : (
              hero.title
            )
          }
        </p>
        <p class="db-hero-pitch" {...fb}>{hero.pitch}</p>
        <p class="db-hero-proof" {...fb}>
          <span>{hero.proof[0]}</span>
          <span class="db-sep" aria-hidden="true">·</span>
          <strong>{hero.proof[1]}</strong>
        </p>
        <div class="db-hero-actions">
          <a class="db-btn" href={ka ? enPage + "#contact" : hero.cta.href} {...fb}>{hero.cta.label}</a>
          <a class="db-link" href={hero.hiring.href} {...fb}>
            {hero.hiring.label}{" "}<span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <div class="db-hero-accent">
        <LedgerAccent />
      </div>
    </section>
    </div>

    {
      !ka && (
        <section class="db-wrap db-proof" aria-label="Proof">
          <ul class="db-proof-list">
            {proof.map((p) => (
              <li>
                <a href={p.href} class="db-tile db-proof-tile">
                  <span class="db-proof-org">{p.org}</span>
                  <span class="db-proof-value tabular">{p.value}</span>
                  <span class="db-proof-label">{p.label}</span>
                  {p.detail && <span class="db-proof-detail">{p.detail}</span>}
                  <span class="db-proof-source">{p.source}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="db-wrap db-section" id="services" aria-labelledby="services-title">
      <div class="db-head">
        <p class="db-idx tabular" aria-hidden="true">01</p>
        <h2 id="services-title">{ka ? kaApproved.whatIDo : offers.heading}</h2>
        <p class="db-intro" {...fb}>{offers.intro}</p>
      </div>
      <ol class="db-grid3">
        {
          offers.items.map((o) => (
            <li class="db-tile db-offer" {...fb}>
              <h3>{o.title}</h3>
              <p>{o.text}</p>
            </li>
          ))
        }
      </ol>
      {
        !ka && (
          <a class="db-link db-more" href={offers.more.href}>
            {offers.more.label}{" "}<span aria-hidden="true">→</span>
          </a>
        )
      }
    </section>

    {
      ka && (
        <section class="db-wrap db-section db-section--last" aria-labelledby="sample-title">
          <div class="db-head">
            <p class="db-idx tabular" aria-hidden="true">
              ka
            </p>
            <h2 id="sample-title" lang="en">
              Typography sample
            </h2>
            <p class="db-intro" lang="en">
              Longer approved Georgian from the current site (older wording, not the new copy). It is here only
              to check the font, line height and line breaks at phone width.
            </p>
          </div>
          <div class="db-sample">
            {kaTypographySample.map((s) => (
              <div class="db-tile">
                <p class="db-sample-label" lang="en">
                  {s.label}
                </p>
                {s.title && <h3>{s.title}</h3>}
                <p>{s.text}</p>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      !ka && (
        <>
          <section class="db-wrap db-section" id="how" aria-labelledby="how-title">
            <div class="db-head">
              <p class="db-idx tabular" aria-hidden="true">02</p>
              <h2 id="how-title">{pipeline.heading}</h2>
              <p class="db-intro">{pipeline.intro}</p>
            </div>
            <div class="db-panel">
              <Pipeline variant="b" />
            </div>
          </section>

          <section class="db-wrap db-section" id="work" aria-labelledby="work-title">
            <div class="db-head">
              <p class="db-idx tabular" aria-hidden="true">03</p>
              <h2 id="work-title">{work.heading}</h2>
            </div>
            <div class="db-work">
              {work.big.map((w, i) => (
                <article class:list={["db-tile db-work-item", { "db-work-item--wide": i === 0 }]} id={`work-${w.slug}`}>
                  <img
                    src={w.image.src}
                    width={w.image.width}
                    height={w.image.height}
                    alt={w.image.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="db-work-text">
                    <p class="db-meta">
                      {w.role}
                      {w.years && <span class="tabular">{" · "}{w.years}</span>}
                    </p>
                    <h3>{w.title}</h3>
                    <p>{w.text}</p>
                    <p class="db-tech">{w.tech.join(" · ")}</p>
                    <div class="db-work-links">
                      {w.url && (
                        <a class="db-link" href={w.url} rel="noopener">
                          {w.url.replace("https://", "")}{" "}<span aria-hidden="true">↗</span>
                        </a>
                      )}
                      {w.note && <span class="db-note">{w.note}</span>}
                    </div>
                  </div>
                </article>
              ))}
            </div>
            <div class="db-small">
              {work.small.map((w) => (
                <article class="db-tile db-small-item" id={`work-${w.slug}`}>
                  <img
                    src={w.image.src}
                    width={w.image.width}
                    height={w.image.height}
                    alt={w.image.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  <div>
                    <p class="db-meta">
                      {w.role}
                      {w.years && <span class="tabular">{" · "}{w.years}</span>}
                    </p>
                    <h3>{w.title}</h3>
                    <p>{w.text}</p>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="db-wrap db-section" id={game.id} aria-label="Lab">
            <div class="db-head">
              <p class="db-idx tabular" aria-hidden="true">04</p>
              <h2>Lab</h2>
            </div>
            <div class="db-lab">
              <article class="db-tile db-game">
                <p class="db-badge">{game.kicker}</p>
                <h3>{game.title}</h3>
                <p>{game.text}</p>
                <p class="db-note">{game.note}</p>
              </article>
              <article class="db-tile db-ask" aria-labelledby="ask-title">
                <div class="db-ask-head">
                  <h3 id="ask-title">{ask.title}</h3>
                  <p class="db-badge">{ask.status}</p>
                </div>
                <p>{ask.text}</p>
                <div class="db-ask-form" role="group" aria-label="Ask a question (not available yet)">
                  <label class="sr-only" for="ask-b">
                    Your question
                  </label>
                  <input id="ask-b" type="text" placeholder={ask.placeholder} disabled />
                  <button type="button" disabled>
                    {ask.button}
                  </button>
                </div>
              </article>
            </div>
          </section>

          <section class="db-wrap db-section" id="open-source" aria-labelledby="oss-title">
            <div class="db-head">
              <p class="db-idx tabular" aria-hidden="true">05</p>
              <h2 id="oss-title">{openSource.heading}</h2>
              <p class="db-intro">
                <strong class="db-strong tabular">{openSource.downloads}</strong>
                {" "}({openSource.downloadsNote})
              </p>
            </div>
            <ul class="db-grid3">
              {openSource.items.map((o) => (
                <li class="db-tile db-oss">
                  <p class="db-meta">{o.kind}</p>
                  <h3>
                    <a href={o.href} rel="noopener">
                      {o.name}
                    </a>
                  </h3>
                  <p>{o.text}</p>
                  <code>{o.install}</code>
                </li>
              ))}
            </ul>
          </section>

          <section class="db-wrap db-section" id="about" aria-labelledby="about-title">
            <div class="db-about">
              <img
                class="db-portrait"
                src="/portrait.webp"
                width="844"
                height="1088"
                alt={about.portraitAlt}
                loading="lazy"
                decoding="async"
              />
              <div>
                <div class="db-head">
                  <p class="db-idx tabular" aria-hidden="true">06</p>
                  <h2 id="about-title">{about.heading}</h2>
                </div>
                {about.bio.map((b) => (
                  <p class="db-about-p">{b}</p>
                ))}
                <p class="db-now">
                  <strong>{about.now.label}</strong>
                  <span>{about.now.text}</span>
                </p>
                <dl class="db-stack">
                  {about.stack.map((s) => (
                    <div>
                      <dt>{s.group}</dt>
                      <dd>{s.items.join(" · ")}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>
          </section>

          <section class="db-wrap db-section db-contact" id="contact" aria-labelledby="contact-title">
            <h2 id="contact-title">{contact.heading}</h2>
            <p class="db-contact-text">{contact.text}</p>
            <div class="db-contact-actions">
              <a class="db-btn" href={contact.book.href}>
                {contact.book.label}
              </a>
              <span class="db-email">
                <a href={`mailto:${contact.email}`}>{contact.email}</a>
                <CopyEmail class="db-copy" />
              </span>
            </div>
            <p class="db-note">{contact.bookNote}</p>
            <p class="db-contact-links">
              {contact.links.map((l) => (
                <a class="db-link" href={l.href} rel="noopener me">
                  {l.label}
                </a>
              ))}
            </p>
          </section>
        </>
      )
    }
  </main>

  <footer class="db-footer">
    <div class="db-wrap db-footer-row">
      <p class="db-receipt" {...fb}>{footer.receipt}</p>
      <p class="db-footer-links">
        <a href={footer.hiring.href} {...fb}>{footer.hiring.label}</a>
        <span class="db-lang">
          <a href={enPage} aria-current={ka ? undefined : "page"} lang="en">EN</a>
          <a href={kaPage} aria-current={ka ? "page" : undefined} lang="ka">KA</a>
        </span>
        <span>{ka ? kaApproved.copyright : footer.copyright}</span>
      </p>
    </div>
  </footer>
</div>

<style is:global>
  .db {
    --bg: #0a0a0b;
    --surface: #111113;
    --surface-2: #17171a;
    --fg: #f5f5f5;
    --muted: #8f8f95;
    --line: #222225;
    --ring: #3a3a40;
    --accent: #4f7df5;
    --accent-strong: #2f5fe0;
    --accent-fg: #ffffff;
    color-scheme: dark;
  }
  .db ::selection {
    background: var(--accent);
    color: var(--bg);
  }
  .db-wrap {
    width: 100%;
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: 20px;
  }
  @media (min-width: 768px) {
    .db-wrap {
      padding-inline: 40px;
    }
  }
  .db a {
    color: inherit;
    text-decoration: none;
  }
  .db [data-fb] {
    outline: 1px dashed #c9a227;
    outline-offset: 3px;
    border-radius: 2px;
  }
  .db-legend {
    margin-top: 1.25rem;
    padding-block: 0.75rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  /* Header */
  .db-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .db-header-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 64px;
  }
  .db-logo {
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .db-nav {
    display: none;
    gap: 1.75rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .db-nav a {
    transition: color var(--dur-fast) ease;
  }
  .db-nav a:hover {
    color: var(--fg);
  }
  @media (min-width: 860px) {
    .db-nav {
      display: flex;
    }
  }
  .db-header-end {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .db-lang {
    display: inline-flex;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .db-lang a {
    display: inline-block;
    padding: 0.25rem 0.2rem;
  }
  .db-lang a[aria-current="page"] {
    color: var(--fg);
    font-weight: 600;
  }

  /* Buttons and links */
  .db-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 1.35rem;
    border-radius: 999px;
    background: var(--accent-strong);
    color: var(--accent-fg) !important;
    font-weight: 600;
    font-size: 0.95rem;
    transition: background-color var(--dur-fast) ease;
  }
  .db-btn:hover {
    background: #3a6af0;
  }
  .db-btn--sm {
    min-height: 36px;
    padding: 0 1rem;
    font-size: 0.85rem;
  }
  .db-link {
    color: var(--fg);
    font-weight: 500;
    border-bottom: 1px solid var(--ring);
    transition: border-color var(--dur-fast) ease;
  }
  .db-link:hover {
    border-color: var(--accent);
  }

  /* Hero */
  .db-hero-shell {
    position: relative;
    isolation: isolate;
  }
  /* A light entrance for the hero text (B and b-rich alike): whole lines, transform + opacity, 300 ms,
     no JavaScript. The text is in the HTML from the first byte; this only eases it in. */
  @media (prefers-reduced-motion: no-preference) {
    .db-hero-text > * {
      animation: db-rise var(--dur-page) var(--ease-out) both;
    }
    .db-hero-text > :nth-child(2) {
      animation-delay: 40ms;
    }
    .db-hero-text > :nth-child(3) {
      animation-delay: 80ms;
    }
    .db-hero-text > :nth-child(n + 4) {
      animation-delay: 120ms;
    }
  }
  @keyframes db-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  .db-hero {
    display: grid;
    gap: 3rem;
    padding-top: 72px;
    padding-bottom: 64px;
  }
  @media (min-width: 1024px) {
    .db-hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      align-items: center;
      padding-top: 112px;
      padding-bottom: 96px;
    }
  }
  .db-hero-accent {
    display: none;
  }
  @media (min-width: 1024px) {
    .db-hero-accent {
      display: flex;
      justify-content: flex-end;
    }
  }
  .db-hero-name {
    margin: 0 0 1rem;
    font-size: clamp(2.75rem, 8vw, 5.75rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }
  .db-hero-name:lang(ka) {
    font-size: clamp(2.2rem, 6.5vw, 4.5rem);
    line-height: 1.2;
  }
  .db-hero-title {
    margin: 0 0 1.75rem;
    font-size: clamp(1.1rem, 2vw, 1.375rem);
    color: var(--muted);
  }
  .db-hero-pitch {
    max-width: 30em;
    margin: 0 0 1.5rem;
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    line-height: 1.5;
    color: var(--fg);
  }
  .db-hero-proof {
    width: fit-content;
    margin: 0 0 2.25rem;
    color: var(--muted);
  }
  .db-hero-proof strong {
    white-space: nowrap;
    color: var(--accent);
    font-weight: 600;
  }
  .db-sep {
    margin: 0 0.45rem;
    color: var(--ring);
  }
  .db-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  /* Tiles */
  .db-tile {
    display: block;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    transition: border-color var(--dur-fast) ease;
  }
  a.db-tile:hover,
  .db-work-item:hover,
  .db-oss:hover {
    border-color: var(--ring);
  }
  .db-tile h3 {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .db-tile p {
    margin: 0;
    color: var(--muted);
  }

  /* Proof strip */
  .db-proof-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 900px) {
    .db-proof-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }
  }
  .db-proof-tile {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.25rem;
  }
  .db-proof-org {
    font-size: 0.8125rem;
    color: var(--accent);
  }
  .db-proof-value {
    margin-top: 0.5rem;
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .db-proof-label {
    margin-top: 0.25rem;
    font-weight: 500;
  }
  .db-proof-detail {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .db-proof-source {
    margin-top: auto;
    padding-top: 0.85rem;
    font-size: 0.75rem;
    color: var(--muted);
  }

  /* Sections */
  .db-section {
    padding-top: 96px;
  }
  @media (min-width: 768px) {
    .db-section {
      padding-top: 136px;
    }
  }
  .db-head {
    margin-bottom: 2.25rem;
  }
  .db-idx {
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
    color: var(--accent);
  }
  .db-head h2 {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }
  .db-head h2:lang(ka) {
    line-height: 1.3;
  }
  .db-intro {
    max-width: 40em;
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 1.0625rem;
  }
  .db-strong {
    color: var(--fg);
  }
  .db-grid3 {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 900px) {
    .db-grid3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .db-offer {
    padding: 1.75rem;
  }
  .db-offer h3 {
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }
  .db-more {
    display: inline-block;
    margin-top: 1.75rem;
  }
  .db-note {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .db-panel {
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--surface);
  }
  @media (min-width: 768px) {
    .db-panel {
      padding: 2.5rem;
    }
