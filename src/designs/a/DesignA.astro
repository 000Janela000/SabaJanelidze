---
// Direction A, "Calm precision": light, lots of space, one quiet green accent. Linear / Stripe restraint.
// The body carries class "da" (set by the page), so the tokens below color the whole page.
import Pipeline from "../../components/Pipeline.astro";
import CopyEmail from "../../components/CopyEmail.astro";
import {
  hero,
  nav,
  proof,
  offers,
  pipeline,
  work,
  game,
  ask,
  openSource,
  about,
  contact,
  footer,
} from "../../content/home";
---
<div id="top">
  <header class="da-header">
    <div class="da-wrap da-header-row">
      <a class="da-logo" href="#top">{hero.name}</a>
      <nav class="da-nav" aria-label="Main">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <div class="da-header-end">
        <a class="da-btn da-btn--sm" href={hero.cta.href}>{hero.cta.label}</a>
        <span class="da-lang">
          <a href="/design/a" aria-current="page">EN<span class="sr-only"> (English)</span></a>
          <a href={footer.lang.ka.href} lang="ka">KA<span class="sr-only" lang="en"> (Georgian)</span></a>
        </span>
      </div>
    </div>
  </header>

  <main id="main" tabindex="-1">
    <section class="da-wrap da-hero" aria-labelledby="hero-title">
      <h1 id="hero-title" class="da-hero-name">
        {hero.name}
        <span class="da-hero-title">{hero.title}</span>
      </h1>
      <p class="da-hero-pitch">{hero.pitch}</p>
      <p class="da-hero-proof">
        <span class="da-dot" aria-hidden="true"></span>
        <span>{hero.proof[0]}</span>
        <span class="da-sep" aria-hidden="true">·</span>
        <strong>{hero.proof[1]}</strong>
      </p>
      <div class="da-hero-actions">
        <a class="da-btn" href={hero.cta.href}>{hero.cta.label}</a>
        <a class="da-link" href={hero.hiring.href}>{hero.hiring.label}{" "}<span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="da-wrap da-proof" aria-label="Proof">
      <ul class="da-proof-list">
        {
          proof.map((p) => (
            <li class="da-proof-item">
              <a href={p.href} class="da-proof-link">
                <span class="da-proof-org">{p.org}</span>
                <span class="da-proof-value tabular">{p.value}</span>
                <span class="da-proof-label">{p.label}</span>
                {p.detail && <span class="da-proof-detail">{p.detail}</span>}
                <span class="da-proof-source">{p.source}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="da-wrap da-section" id="services" aria-labelledby="services-title">
      <div class="da-section-head">
        <h2 id="services-title">{offers.heading}</h2>
        <p>{offers.intro}</p>
      </div>
      <ol class="da-offers">
        {
          offers.items.map((o, i) => (
            <li class="da-card">
              <p class="da-card-num tabular">{String(i + 1).padStart(2, "0")}</p>
              <h3>{o.title}</h3>
              <p>{o.text}</p>
            </li>
          ))
        }
      </ol>
      <a class="da-link da-more" href={offers.more.href}>{offers.more.label}{" "}<span aria-hidden="true">→</span></a>
    </section>

    <section class="da-wrap da-section" id="how" aria-labelledby="how-title">
      <div class="da-section-head">
        <h2 id="how-title">{pipeline.heading}</h2>
        <p>{pipeline.intro}</p>
      </div>
      <Pipeline variant="a" />
    </section>

    <section class="da-wrap da-section" id="work" aria-labelledby="work-title">
      <div class="da-section-head">
        <h2 id="work-title">{work.heading}</h2>
      </div>
      <div class="da-work">
        {
          work.big.map((w) => (
            <article class="da-work-item" id={`work-${w.slug}`}>
              <div class="da-work-media">
                <img
                  src={w.image.src}
                  width={w.image.width}
                  height={w.image.height}
                  alt={w.image.alt}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="da-work-text">
                <p class="da-work-role">
                  {w.role}
                  {w.years && <span class="tabular">{" · "}{w.years}</span>}
                </p>
                <h3>{w.title}</h3>
                <p>{w.text}</p>
                <ul class="da-tags" aria-label="Stack">
                  {w.tech.map((t) => <li>{t}</li>)}
                </ul>
                <div class="da-work-links">
                  {w.url && (
                    <a class="da-link" href={w.url} rel="noopener">
                      {w.url.replace("https://", "")}{" "}<span aria-hidden="true">↗</span>
                    </a>
                  )}
                  {w.note && <span class="da-note">{w.note}</span>}
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <div class="da-work-small">
        {
          work.small.map((w) => (
            <article class="da-card da-small" id={`work-${w.slug}`}>
              <img
                src={w.image.src}
                width={w.image.width}
                height={w.image.height}
                alt={w.image.alt}
                loading="lazy"
                decoding="async"
              />
              <div>
                <p class="da-work-role">
                  {w.role}
                  {w.years && <span class="tabular">{" · "}{w.years}</span>}
                </p>
                <h3>{w.title}</h3>
                <p>{w.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="da-wrap da-section" id={game.id} aria-label="Lab">
      <div class="da-lab">
        <article class="da-card da-game">
          <p class="da-pill">{game.kicker}</p>
          <h2>{game.title}</h2>
          <p>{game.text}</p>
          <p class="da-note">{game.note}</p>
        </article>
        <article class="da-card da-ask" aria-labelledby="ask-title">
          <div class="da-ask-head">
            <h2 id="ask-title">{ask.title}</h2>
            <p class="da-pill">{ask.status}</p>
          </div>
          <p>{ask.text}</p>
          <div class="da-ask-form" role="group" aria-label="Ask a question (not available yet)">
            <label class="sr-only" for="ask-a">Your question</label>
            <input id="ask-a" type="text" placeholder={ask.placeholder} disabled />
            <button type="button" disabled>{ask.button}</button>
          </div>
        </article>
      </div>
    </section>

    <section class="da-wrap da-section" id="open-source" aria-labelledby="oss-title">
      <div class="da-section-head">
        <h2 id="oss-title">{openSource.heading}</h2>
        <p>
          <strong class="tabular">{openSource.downloads}</strong>
          <span class="da-muted">{" "}({openSource.downloadsNote})</span>
        </p>
      </div>
      <ul class="da-oss">
        {
          openSource.items.map((o) => (
            <li class="da-card">
              <h3>
                <a href={o.href} rel="noopener">{o.name}</a>
              </h3>
              <p class="da-work-role">{o.kind}</p>
              <p>{o.text}</p>
              <code class="da-code">{o.install}</code>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="da-wrap da-section" id="about" aria-labelledby="about-title">
      <div class="da-about">
        <img
          class="da-portrait"
          src="/portrait.webp"
          width="844"
          height="1088"
          alt={about.portraitAlt}
          loading="lazy"
          decoding="async"
        />
        <div>
          <h2 id="about-title">{about.heading}</h2>
          {about.bio.map((b) => <p class="da-about-p">{b}</p>)}
          <p class="da-now">
            <span class="da-dot" aria-hidden="true"></span>
            <strong>{about.now.label}:</strong>{" "}{about.now.text}
          </p>
          <dl class="da-stack">
            {
              about.stack.map((s) => (
                <div>
                  <dt>{s.group}</dt>
                  <dd>{s.items.join(", ")}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <section class="da-wrap da-section da-contact" id="contact" aria-labelledby="contact-title">
      <h2 id="contact-title">{contact.heading}</h2>
      <p class="da-contact-text">{contact.text}</p>
      <div class="da-contact-actions">
        <a class="da-btn" href={contact.book.href}>{contact.book.label}</a>
        <span class="da-email">
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
          <CopyEmail class="da-copy" />
        </span>
      </div>
      <p class="da-note">{contact.bookNote}</p>
      <p class="da-contact-links">
        {
          contact.links.map((l) => (
            <a class="da-link" href={l.href} rel="noopener me">
              {l.label}
            </a>
          ))
        }
      </p>
    </section>
  </main>

  <footer class="da-footer">
    <div class="da-wrap da-footer-row">
      <p class="da-receipt">{footer.receipt}</p>
      <p class="da-footer-links">
        <a href={footer.hiring.href}>{footer.hiring.label}</a>
        <span class="da-lang">
          <a href="/design/a" aria-current="page">EN</a>
          <a href={footer.lang.ka.href} lang="ka">KA</a>
        </span>
        <span class="da-muted">{footer.copyright}</span>
      </p>
    </div>
  </footer>
</div>

<style is:global>
  .da {
    --bg: #fbfbfa;
    --surface: #f2f3f1;
    --fg: #111315;
    --muted: #5b6168;
    --line: #e4e5e2;
    --ring: #b5b9be;
    --accent: #0b7356;
    --accent-fg: #ffffff;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    .da {
      --bg: #0f1011;
      --surface: #17191b;
      --fg: #ececea;
      --muted: #9ba1a7;
      --line: #26292c;
      --ring: #4b5056;
      --accent: #43c39a;
      --accent-fg: #04140e;
      color-scheme: dark;
    }
  }
  .da-wrap {
    width: 100%;
    max-width: 1120px;
    margin-inline: auto;
    padding-inline: 20px;
  }
  @media (min-width: 768px) {
    .da-wrap {
      padding-inline: 40px;
    }
  }
  .da a {
    color: inherit;
    text-decoration: none;
  }
  .da-muted {
    color: var(--muted);
  }

  /* Header */
  .da-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .da-header-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 60px;
  }
  .da-logo {
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .da-nav {
    display: none;
    gap: 1.75rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .da-nav a:hover {
    color: var(--fg);
  }
  @media (min-width: 860px) {
    .da-nav {
      display: flex;
    }
  }
  .da-header-end {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .da-lang {
    display: inline-flex;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .da-lang a {
    display: inline-block;
    padding: 0.25rem 0.2rem;
  }
  .da-lang a[aria-current="page"] {
    color: var(--fg);
    font-weight: 600;
  }

  /* Buttons and links */
  .da-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 1.25rem;
    border-radius: 8px;
    background: var(--fg);
    color: var(--bg) !important;
    font-weight: 600;
    font-size: 0.95rem;
    transition: background-color var(--dur-fast) ease;
  }
  .da-btn:hover {
    background: var(--accent);
    color: var(--accent-fg) !important;
  }
  .da-btn--sm {
    min-height: 36px;
    padding: 0 0.9rem;
    font-size: 0.85rem;
  }
  .da-link {
    color: var(--fg);
    font-weight: 500;
    border-bottom: 1px solid var(--line);
    transition: border-color var(--dur-fast) ease;
  }
  .da-link:hover {
    border-color: var(--accent);
  }
  .da-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }

  /* Hero */
  .da-hero {
    padding-top: 72px;
    padding-bottom: 56px;
  }
  @media (min-width: 768px) {
    .da-hero {
      padding-top: 120px;
      padding-bottom: 80px;
    }
  }
  .da-hero-name {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    margin: 0 0 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .da-hero-title {
    font-weight: 400;
    color: var(--muted);
  }
  .da-hero-pitch {
    max-width: 21em;
    margin: 0 0 1.75rem;
    font-size: clamp(1.9rem, 4.6vw, 3.25rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }
  .da-hero-proof {
    margin: 0 0 2.25rem;
    color: var(--muted);
    font-size: 1rem;
  }
  .da-hero-proof strong {
    white-space: nowrap;
    color: var(--fg);
    font-weight: 600;
  }
  .da-hero-proof .da-dot {
    margin-right: 0.6rem;
    vertical-align: 0.15em;
  }
  .da-sep {
    margin: 0 0.45rem;
    color: var(--ring);
  }
  .da-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  /* Proof strip */
  .da-proof-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .da-proof-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .da-proof-item {
    border-right: 1px solid var(--line);
  }
  .da-proof-item:nth-child(2n) {
    border-right: 0;
  }
  .da-proof-item:nth-child(-n + 2) {
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .da-proof-item:nth-child(2n) {
      border-right: 1px solid var(--line);
    }
    .da-proof-item:last-child {
      border-right: 0;
    }
    .da-proof-item:nth-child(-n + 2) {
      border-bottom: 0;
    }
  }
  .da-proof-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem 1rem 1.25rem 0;
    transition: background-color var(--dur-fast) ease;
  }
  .da-proof-item:nth-child(2n) .da-proof-link {
    padding-left: 1rem;
  }
  @media (min-width: 900px) {
    .da-proof-link,
    .da-proof-item:nth-child(2n) .da-proof-link {
      padding: 1.75rem 1.25rem;
    }
    .da-proof-item:first-child .da-proof-link {
      padding-left: 0;
    }
  }
  .da-proof-org {
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .da-proof-value {
    margin-top: 0.4rem;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .da-proof-label {
    margin-top: 0.2rem;
    font-weight: 500;
  }
  .da-proof-detail {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .da-proof-source {
    margin-top: auto;
    padding-top: 0.75rem;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .da-proof-link:hover .da-proof-value {
    color: var(--accent);
  }

  /* Sections */
  .da-section {
    padding-top: 88px;
  }
  @media (min-width: 768px) {
    .da-section {
      padding-top: 128px;
    }
  }
  .da-section-head {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 900px) {
    .da-section-head {
      grid-template-columns: 5fr 6fr;
      align-items: end;
      gap: 2rem;
    }
  }
  .da-section-head h2,
  .da-section h2 {
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.022em;
    line-height: 1.15;
  }
  .da-section-head p {
    margin: 0;
    color: var(--muted);
    max-width: 38em;
  }
  .da-card {
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg);
  }
  .da-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .da-card p {
    margin: 0;
    color: var(--muted);
  }
  .da-card-num {
    margin-bottom: 2.5rem !important;
    font-size: 0.8125rem;
  }
  .da-offers,
  .da-oss {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 900px) {
    .da-offers,
    .da-oss {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .da-more {
    display: inline-block;
    margin-top: 1.75rem;
  }
  .da-note {
    font-size: 0.875rem;
    color: var(--muted);
  }

  /* Work */
  .da-work {
    display: grid;
    gap: 64px;
  }
  .da-work-item {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 900px) {
    .da-work-item {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 3rem;
      align-items: center;
    }
  }
  .da-work-media img,
  .da-small img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
  }
  .da-work-role {
    margin: 0 0 0.4rem !important;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .da-work-text h3 {
    margin: 0 0 0.6rem;
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .da-work-text > p {
    margin: 0 0 1rem;
    color: var(--muted);
  }
  .da-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
  }
  .da-tags li {
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .da-work-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
  }
  .da-work-small {
    display: grid;
    gap: 1rem;
    margin-top: 64px;
  }
  @media (min-width: 768px) {
    .da-work-small {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .da-small {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }
  .da-small h3 {
    font-size: 1.05rem;
  }
  .da-small p:last-child {
    font-size: 0.9rem;
  }
  @media (max-width: 479px) {
    .da-small {
      grid-template-columns: 1fr;
    }
  }

  /* Lab: game teaser + Ask the work */
  .da-lab {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }
  @media (min-width: 900px) {
    .da-lab {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
  .da-lab h2 {
    font-size: 1.5rem !important;
    margin-bottom: 0.6rem !important;
  }
  .da-game {
    background: var(--surface);
    border-color: transparent;
    padding: 2rem;
  }
  .da-game > p {
    max-width: 36em;
  }
  .da-game .da-note {
    margin-top: 1rem;
  }
  .da-pill {
    display: inline-block;
    margin: 0 0 1rem !important;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    background: var(--bg);
    color: var(--accent) !important;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .da-ask-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }
  .da-ask-form {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .da-ask-form input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    padding: 0 0.85rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    color: var(--muted);
    font-size: 16px;
  }
  .da-ask-form button {
    min-height: 44px;
    padding: 0 1rem;
