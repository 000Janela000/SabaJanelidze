---
// Direction C, "Engineering notebook": diagrams and code-like details first, a paper-and-grid feel,
// monospace used sparingly (labels, numbers, commands). Every sentence is still plain English.
import Pipeline from "../../components/Pipeline.astro";
import CopyEmail from "../../components/CopyEmail.astro";
import {
  hero,
  nav,
  proof,
  offers,
  pipeline,
  work,
  game,
  ask,
  openSource,
  about,
  contact,
  footer,
} from "../../content/home";

const sections = {
  services: "§1",
  how: "§2",
  work: "§3",
  lab: "§4",
  oss: "§5",
  about: "§6",
  contact: "§7",
};
---
<div id="top">
  <header class="dc-header">
    <div class="dc-wrap dc-header-row">
      <a class="dc-logo" href="#top">
        {hero.name}
        <span class="dc-mono dc-logo-tag" aria-hidden="true">/ notebook</span>
      </a>
      <nav class="dc-nav" aria-label="Main">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <div class="dc-header-end">
        <a class="dc-btn dc-btn--sm" href={hero.cta.href}>{hero.cta.label}</a>
        <span class="dc-lang dc-mono">
          <a href="/design/c" aria-current="page">EN<span class="sr-only"> (English)</span></a>
          <span aria-hidden="true">/</span>
          <a href={footer.lang.ka.href} lang="ka">KA<span class="sr-only" lang="en"> (Georgian)</span></a>
        </span>
      </div>
    </div>
  </header>

  <main id="main" tabindex="-1">
    <section class="dc-wrap dc-hero" aria-labelledby="hero-title">
      <div class="dc-hero-text">
        <p class="dc-mono dc-doc">portfolio · rev. 2026-10</p>
        <h1 id="hero-title" class="dc-hero-name">{hero.name}</h1>
        <p class="dc-hero-title">{hero.title}</p>
        <p class="dc-hero-pitch">{hero.pitch}</p>
        <p class="dc-hero-proof">
          <span>{hero.proof[0]}</span>
          <span class="dc-sep" aria-hidden="true">·</span>
          <strong>{hero.proof[1]}</strong>
        </p>
        <div class="dc-hero-actions">
          <a class="dc-btn" href={hero.cta.href}>{hero.cta.label}</a>
          <a class="dc-link" href={hero.hiring.href}>{hero.hiring.label}{" "}<span aria-hidden="true">→</span></a>
        </div>
      </div>

      <figure class="dc-fig dc-hero-fig">
        <svg viewBox="0 0 440 318" role="img" aria-labelledby="fig1-title fig1-desc" class="dc-schematic">
          <title id="fig1-title">A payment request that arrives twice is charged once</title>
          <desc id="fig1-desc">
            A withdrawal request carries an idempotency key. The server checks whether it has seen the key before. If yes,
            it returns the first result. If no, it writes two ledger entries, a debit and a credit, that sum to zero.
          </desc>
          <defs>
            <marker id="arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto">
              <path d="M0 0 L8 4 L0 8 z" class="sx-fill"></path>
            </marker>
          </defs>
          <rect x="1" y="1" width="278" height="52" rx="3" class="sx-box"></rect>
          <text x="14" y="23" class="sx-t">POST /withdraw  amount=80.00</text>
          <text x="14" y="41" class="sx-t sx-m">Idempotency-Key: 7f3a…</text>
          <text x="292" y="23" class="sx-t sx-note">×2</text>
          <text x="292" y="41" class="sx-t sx-note sx-s">client retried</text>

          <line x1="140" y1="54" x2="140" y2="90" class="sx-line" marker-end="url(#arrow)"></line>

          <rect x="1" y="92" width="278" height="44" rx="3" class="sx-box"></rect>
          <text x="14" y="119" class="sx-t">key seen before?</text>

          <line x1="280" y1="114" x2="326" y2="114" class="sx-line" marker-end="url(#arrow)"></line>
          <text x="292" y="107" class="sx-t sx-m sx-s">yes</text>
          <rect x="328" y="92" width="111" height="44" rx="3" class="sx-box sx-box--soft"></rect>
          <text x="340" y="111" class="sx-t sx-s">return the</text>
          <text x="340" y="126" class="sx-t sx-s">first result</text>

          <line x1="140" y1="137" x2="140" y2="172" class="sx-line" marker-end="url(#arrow)"></line>
          <text x="150" y="160" class="sx-t sx-m sx-s">no</text>

          <rect x="1" y="174" width="278" height="108" rx="3" class="sx-box"></rect>
          <text x="14" y="196" class="sx-t sx-m sx-s">ledger</text>
          <text x="14" y="220" class="sx-t">debit   wallet:customer   80.00</text>
          <text x="14" y="242" class="sx-t">credit  payouts:pending   80.00</text>
          <line x1="14" y1="254" x2="266" y2="254" class="sx-rule"></line>
          <text x="14" y="272" class="sx-t sx-accent">Σ debit − Σ credit = 0.00</text>

          <text x="1" y="310" class="sx-t sx-accent">✓ charged once</text>
        </svg>
        <figcaption class="dc-mono dc-cap">
          fig. 1 — a request that arrives twice is charged once; every money move is two entries that sum to zero.
        </figcaption>
      </figure>
    </section>

    <section class="dc-wrap dc-proof" aria-labelledby="proof-title">
      <p id="proof-title" class="dc-mono dc-cap dc-proof-cap">table 1 — numbers I can point to</p>
      <ul class="dc-spec">
        {
          proof.map((p) => (
            <li class="dc-spec-row">
              <span class="dc-spec-org">{p.org}</span>
              <a class="dc-spec-value dc-mono tabular" href={p.href}>
                {p.value}
              </a>
              <span class="dc-spec-label">
                {p.label}
                {p.detail && <span class="dc-spec-detail">{p.detail}</span>}
              </span>
              <span class="dc-spec-source dc-mono">{p.source}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="dc-wrap dc-sec" id="services" aria-labelledby="services-title">
      <div class="dc-margin">
        <p class="dc-mono dc-secnum">{sections.services}</p>
      </div>
      <div class="dc-main">
        <h2 id="services-title">{offers.heading}</h2>
        <p class="dc-intro">{offers.intro}</p>
        <ol class="dc-cards">
          {
            offers.items.map((o, i) => (
              <li class="dc-card">
                <p class="dc-mono dc-card-tag">
                  {sections.services}.{i + 1}
                </p>
                <h3>{o.title}</h3>
                <p>{o.text}</p>
              </li>
            ))
          }
        </ol>
        <a class="dc-link dc-more" href={offers.more.href}>{offers.more.label}{" "}<span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="dc-wrap dc-sec" id="how" aria-labelledby="how-title">
      <div class="dc-margin">
        <p class="dc-mono dc-secnum">{sections.how}</p>
      </div>
      <div class="dc-main">
        <h2 id="how-title">{pipeline.heading}</h2>
        <p class="dc-intro">{pipeline.intro}</p>
        <figure class="dc-fig dc-fig--wide">
          <Pipeline variant="c" />
          <figcaption class="dc-mono dc-cap">fig. 2 — how a change gets from idea to production.</figcaption>
        </figure>
      </div>
    </section>

    <section class="dc-wrap dc-sec" id="work" aria-labelledby="work-title">
      <div class="dc-margin">
        <p class="dc-mono dc-secnum">{sections.work}</p>
      </div>
      <div class="dc-main">
        <h2 id="work-title">{work.heading}</h2>
        <div class="dc-work">
          {
            work.big.map((w, i) => (
              <article class="dc-plate" id={`work-${w.slug}`}>
                <figure class="dc-plate-fig">
                  <img
                    src={w.image.src}
                    width={w.image.width}
                    height={w.image.height}
                    alt={w.image.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption class="dc-mono dc-cap">
                    fig. 3{String.fromCharCode(97 + i)} — {w.image.alt.toLowerCase()}
                  </figcaption>
                </figure>
                <div class="dc-plate-text">
                  <h3>{w.title}</h3>
                  <p>{w.text}</p>
                  <dl class="dc-kv">
                    <div>
                      <dt>role</dt>
                      <dd>{w.role}</dd>
                    </div>
                    {w.years && (
                      <div>
                        <dt>years</dt>
                        <dd class="tabular">{w.years}</dd>
                      </div>
                    )}
                    <div>
                      <dt>stack</dt>
                      <dd>{w.tech.join(", ")}</dd>
                    </div>
                    {w.url && (
                      <div>
                        <dt>live</dt>
                        <dd>
                          <a class="dc-link" href={w.url} rel="noopener">
                            {w.url.replace("https://", "")}
                          </a>
                        </dd>
                      </div>
                    )}
                  </dl>
                  {w.note && <p class="dc-note">{w.note}</p>}
                </div>
              </article>
            ))
          }
        </div>
        <div class="dc-small">
          {
            work.small.map((w) => (
              <article class="dc-card dc-small-item" id={`work-${w.slug}`}>
                <img
                  src={w.image.src}
                  width={w.image.width}
                  height={w.image.height}
                  alt={w.image.alt}
                  loading="lazy"
                  decoding="async"
                />
                <div>
                  <h3>{w.title}</h3>
                  <p class="dc-mono dc-small-meta">
                    {w.role}
                    {w.years && <span>{" · "}{w.years}</span>}
                  </p>
                  <p>{w.text}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="dc-wrap dc-sec" id={game.id} aria-label="Lab">
      <div class="dc-margin">
        <p class="dc-mono dc-secnum">{sections.lab}</p>
      </div>
      <div class="dc-main dc-lab">
        <article class="dc-card dc-game">
          <p class="dc-mono dc-stamp">{game.kicker}</p>
          <h2>{game.title}</h2>
          <p>{game.text}</p>
          <p class="dc-note">{game.note}</p>
        </article>
        <article class="dc-card dc-ask" aria-labelledby="ask-title">
          <p class="dc-mono dc-stamp">{ask.status}</p>
          <h2 id="ask-title">{ask.title}</h2>
          <p>{ask.text}</p>
          <div class="dc-ask-form" role="group" aria-label="Ask a question (not available yet)">
            <span class="dc-mono dc-prompt" aria-hidden="true">&gt;</span>
            <label class="sr-only" for="ask-c">Your question</label>
            <input id="ask-c" type="text" placeholder={ask.placeholder} disabled />
            <button type="button" disabled>{ask.button}</button>
          </div>
        </article>
      </div>
    </section>

    <section class="dc-wrap dc-sec" id="open-source" aria-labelledby="oss-title">
      <div class="dc-margin">
        <p class="dc-mono dc-secnum">{sections.oss}</p>
      </div>
      <div class="dc-main">
        <h2 id="oss-title">{openSource.heading}</h2>
        <p class="dc-intro">
          <strong class="dc-mono tabular">{openSource.downloads}</strong>
          {" "}({openSource.downloadsNote})
        </p>
        <ul class="dc-oss">
          {
            openSource.items.map((o) => (
              <li class="dc-oss-row">
                <div>
                  <h3>
                    <a class="dc-link" href={o.href} rel="noopener">
                      {o.name}
                    </a>
                  </h3>
                  <p class="dc-mono dc-small-meta">{o.kind}</p>
                </div>
                <p>{o.text}</p>
                <code class="dc-cmd">
                  <span aria-hidden="true">$ </span>
                  {o.install}
                </code>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="dc-wrap dc-sec" id="about" aria-labelledby="about-title">
      <div class="dc-margin">
        <p class="dc-mono dc-secnum">{sections.about}</p>
      </div>
      <div class="dc-main dc-about">
        <figure class="dc-portrait">
          <img src="/portrait.webp" width="844" height="1088" alt={about.portraitAlt} loading="lazy" decoding="async" />
          <figcaption class="dc-mono dc-cap">fig. 4 — Saba Janelidze</figcaption>
        </figure>
        <div>
          <h2 id="about-title">{about.heading}</h2>
          {about.bio.map((b) => <p class="dc-about-p">{b}</p>)}
          <p class="dc-now">
            <span class="dc-mono dc-now-date">2026-10</span>
            <span>
              <strong>{about.now.label}:</strong>{" "}{about.now.text}
            </span>
          </p>
          <dl class="dc-kv dc-stack">
            {
              about.stack.map((s) => (
                <div>
                  <dt>{s.group.toLowerCase()}</dt>
                  <dd>{s.items.join(", ")}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <section class="dc-wrap dc-sec dc-contact" id="contact" aria-labelledby="contact-title">
      <div class="dc-margin">
        <p class="dc-mono dc-secnum">{sections.contact}</p>
      </div>
      <div class="dc-main">
        <h2 id="contact-title">{contact.heading}</h2>
        <p class="dc-intro">{contact.text}</p>
        <div class="dc-contact-actions">
          <a class="dc-btn" href={contact.book.href}>{contact.book.label}</a>
          <span class="dc-email">
            <a class="dc-mono" href={`mailto:${contact.email}`}>{contact.email}</a>
            <CopyEmail class="dc-copy" />
          </span>
        </div>
        <p class="dc-note">{contact.bookNote}</p>
        <p class="dc-contact-links">
          {
            contact.links.map((l) => (
              <a class="dc-link" href={l.href} rel="noopener me">
                {l.label}
              </a>
            ))
          }
        </p>
      </div>
    </section>
  </main>

  <footer class="dc-footer">
    <div class="dc-wrap dc-footer-row">
      <p class="dc-receipt dc-mono">{footer.receipt}</p>
      <p class="dc-footer-links">
        <a href={footer.hiring.href}>{footer.hiring.label}</a>
        <span class="dc-lang dc-mono">
          <a href="/design/c" aria-current="page">EN</a>
          <span aria-hidden="true">/</span>
          <a href={footer.lang.ka.href} lang="ka">KA</a>
        </span>
        <span>{footer.copyright}</span>
      </p>
    </div>
  </footer>
</div>

<style is:global>
  .dc {
    --bg: #f5f3ec;
    --surface: #fbfaf6;
    --fg: #1b2130;
    --muted: #535a69;
    --line: #d6d1c3;
    --ring: #8a8e98;
    --accent: #2342b8;
    --accent-fg: #ffffff;
    --note: #a8441b;
    --grid: rgba(27, 33, 48, 0.05);
    color-scheme: light;
    background-color: var(--bg);
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  .dc-wrap {
    width: 100%;
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: 20px;
  }
  @media (min-width: 768px) {
    .dc-wrap {
      padding-inline: 40px;
    }
  }
  .dc a {
    color: inherit;
    text-decoration: none;
  }
  .dc-mono {
    font-family: var(--font-code);
  }
  .dc-cap {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    color: var(--muted);
  }

  /* Header */
  .dc-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--fg);
  }
  .dc-header-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 60px;
  }
  .dc-logo {
    font-weight: 600;
  }
  .dc-logo-tag {
    display: none;
    margin-left: 0.4rem;
    font-weight: 400;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  @media (min-width: 640px) {
    .dc-logo-tag {
      display: inline;
    }
  }
  .dc-nav {
    display: none;
    gap: 1.5rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .dc-nav a:hover {
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (min-width: 900px) {
    .dc-nav {
      display: flex;
    }
  }
  .dc-header-end {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .dc-lang {
    display: inline-flex;
    gap: 0.35rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .dc-lang a {
    display: inline-block;
    padding: 0.25rem 0.2rem;
  }
  .dc-lang a[aria-current="page"] {
    color: var(--fg);
    font-weight: 600;
  }

  /* Buttons and links */
  .dc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 1.2rem;
    border: 1px solid var(--fg);
    border-radius: 3px;
    background: var(--fg);
    color: var(--bg) !important;
    font-weight: 600;
    font-size: 0.95rem;
    box-shadow: 3px 3px 0 var(--accent);
    transition: transform var(--dur-instant) ease;
  }
  @media (prefers-reduced-motion: no-preference) {
    .dc-btn:active {
      transform: translate(2px, 2px);
    }
  }
  .dc-btn--sm {
    min-height: 34px;
    padding: 0 0.85rem;
    font-size: 0.85rem;
    box-shadow: none;
  }
  .dc-link {
    color: var(--accent);
    text-decoration: underline !important;
    text-decoration-thickness: 1px !important;
    text-underline-offset: 3px;
  }
  .dc-link:hover {
    text-decoration-thickness: 2px !important;
  }

  /* Hero */
  .dc-hero {
    display: grid;
    gap: 3rem;
    padding-top: 56px;
    padding-bottom: 56px;
  }
  @media (min-width: 1024px) {
    .dc-hero {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: center;
      gap: 4rem;
      padding-top: 96px;
      padding-bottom: 88px;
    }
  }
  .dc-doc {
    margin: 0 0 1.25rem;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .dc-hero-name {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .dc-hero-title {
    margin: 0.6rem 0 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--fg);
    font-size: 1.125rem;
    color: var(--fg);
  }
  .dc-hero-pitch {
    max-width: 30em;
    margin: 0 0 1.25rem;
    font-size: clamp(1.15rem, 1.8vw, 1.375rem);
    line-height: 1.5;
  }
  .dc-hero-proof {
    width: fit-content;
    margin: 0 0 2rem;
    padding: 0.55rem 0.85rem;
    border-left: 3px solid var(--note);
    background: var(--surface);
    font-size: 0.95rem;
    color: var(--muted);
  }
  .dc-hero-proof strong {
    white-space: nowrap;
    color: var(--fg);
  }
  .dc-sep {
    margin: 0 0.45rem;
    color: var(--ring);
  }
  .dc-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  /* Figures */
  .dc-fig {
    margin: 0;
  }
  .dc-hero-fig {
    padding: 1.25rem;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .dc-schematic {
    display: block;
    width: 100%;
    height: auto;
    max-width: 440px;
    margin-inline: auto;
  }
  .sx-box {
    fill: var(--surface);
    stroke: var(--fg);
    stroke-width: 1.25;
  }
  .sx-box--soft {
    stroke-dasharray: 4 3;
  }
  .sx-line {
    stroke: var(--fg);
    stroke-width: 1.25;
  }
  .sx-rule {
    stroke: var(--line);
  }
  .sx-fill {
    fill: var(--fg);
  }
  .sx-t {
    white-space: pre;
    font-family: var(--font-code);
    font-size: 12.5px;
    fill: var(--fg);
  }
  .sx-m {
    fill: var(--muted);
  }
  .sx-s {
    font-size: 11px;
  }
  .sx-note {
    fill: var(--note);
  }
  .sx-accent {
    fill: var(--accent);
  }

  /* Proof table */
  .dc-proof-cap {
    margin: 0 0 0.75rem;
  }
  .dc-spec {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--fg);
    border-bottom: 1px solid var(--fg);
    background: var(--surface);
  }
  .dc-spec-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.15rem 1rem;
    padding: 1rem 0.25rem;
    border-bottom: 1px solid var(--line);
  }
  .dc-spec-row:last-child {
    border-bottom: 0;
  }
  .dc-spec-org {
    font-weight: 600;
  }
  .dc-spec-source {
    grid-column: 2;
    grid-row: 1;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .dc-spec-value {
    grid-column: 1 / -1;
    font-size: 1.6rem;
    color: var(--accent);
  }
  .dc-spec-value:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .dc-spec-label {
    grid-column: 1 / -1;
    color: var(--fg);
  }
  .dc-spec-detail {
    display: block;
    font-size: 0.875rem;
    color: var(--muted);
  }
  @media (min-width: 900px) {
    .dc-spec-row {
      grid-template-columns: 130px 170px minmax(0, 1fr) 190px;
      align-items: baseline;
      padding: 0.9rem 1rem;
    }
    .dc-spec-org,
    .dc-spec-value,
