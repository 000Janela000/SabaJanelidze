---
// Page shell for every page: <head> (SEO, fonts, theme colours) and the skip link.
import "../../styles/global.css";
import SeoHead from "./seo-head.astro";
import Fonts from "./fonts.astro";
import type { Lang } from "../lib/site";
import { THEME_COLOR } from "../lib/theme-colors";

interface Props {
  title: string;
  description: string;
  lang: Lang;
  path: string;
  noindex?: boolean;
  jsonLd?: object | object[];
  ogType?: "website" | "profile";
}

const {
  title,
  description,
  lang,
  path,
  noindex,
  jsonLd,
  ogType,
} = Astro.props;

// Runs before the first paint, so the page never flashes the wrong theme:
// marks that JavaScript works (class "js") and applies a theme the visitor picked earlier in the footer switch.
// Version 1 values ("paper", "blueprint") are read as "light" and "dark".
// localStorage can throw (private mode, blocked storage); then the system setting decides, as without JavaScript.
// Keep it tiny; a later Content-Security-Policy allows it by its hash.
const themeBoot = `(function(){var d=document.documentElement;d.classList.add("js");try{var t=localStorage.getItem("theme");if(t==="paper")t="light";if(t==="blueprint")t="dark";if(t==="light"||t==="dark"){d.setAttribute("data-theme",t);var c=t==="light"?"${THEME_COLOR.light}":"${THEME_COLOR.dark}";document.querySelectorAll('meta[name="theme-color"]').forEach(function(m){m.setAttribute("content",c)})}}catch(e){}})();`;

const skip = "Skip to content";
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      title={title}
      description={description}
      lang={lang}
      path={path}
      noindex={noindex}
      jsonLd={jsonLd}
      ogType={ogType}
    />
    <Fonts />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={THEME_COLOR.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={THEME_COLOR.dark} media="(prefers-color-scheme: dark)" />
    <script is:inline set:html={themeBoot} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main" lang="en">{skip}</a>
    <slot />
    {/* Cloudflare Web Analytics (no cookies), the same site token as the old site; allowed by the CSP in public/_headers.
        Only in the built site: the local dev server would count nothing and only log errors. */}
    {import.meta.env.PROD && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "8fd5348ab0444874be665a51419145b6"}'></script>
    )}
  </body>
</html>
