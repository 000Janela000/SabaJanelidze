---
// The site footer: "For hiring managers", the theme switch (Light / Dark / Auto) and the copyright.
import ThemeSwitch from "./theme-switch.astro";
import { footer } from "../content/site-chrome";

interface Props {
  /** On /cv the hiring link would point to the page itself, so it becomes "Home". */
  onCv?: boolean;
}
const { onCv = false } = Astro.props;
const first = onCv ? footer.homeLink : footer.cvLink;
---
<footer class="ft">
  <div class="ui-wrap ft-row">
    <p class="ft-links">
      <a class="ui-link" href={first.href}>{first.label}</a>
      <span>{footer.copyright}</span>
    </p>
    <ThemeSwitch />
  </div>
</footer>

<style>
  .ft {
    margin-top: var(--section-space);
    border-top: 1px solid var(--line);
  }
  .ft-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    padding-top: var(--space-5);
    padding-bottom: var(--space-6);
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .ft-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    margin: 0;
  }
</style>
