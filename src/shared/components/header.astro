---
// The sticky site header: the name and the main links, nothing else, so it never overflows. Phones (under
// 640 px) show the links marked onPhone. Nav links change instantly (motion rule 5).
import { nav } from "../content/site-chrome";
import { PERSON } from "../lib/site";

// Section links are "#work" on the home page and "/#work" everywhere else.
const onHome = Astro.url.pathname === "/" || Astro.url.pathname === "/index.html";
const link = (href: string) => (onHome || !href.startsWith("#") ? href : `/${href}`);
---
<header class="header">
  <div class="ui-wrap header-row">
    <a class="header-logo" href="/">{PERSON.name}</a>
    <nav class="header-nav" aria-label="Main">
      {nav.map((n) => <a class:list={[{ "header-wide": !n.onPhone }]} href={link(n.href)}>{n.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: var(--header-h);
  }
  .header-logo {
    flex: none;
    color: var(--fg);
    font-weight: var(--weight-strong);
    text-decoration: none;
    white-space: nowrap;
  }
  .header-nav {
    display: flex;
    align-items: center;
    gap: var(--space-1) var(--space-5);
    min-width: 0;
    font-size: var(--fs-sm);
  }
  .header-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-1);
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .header-nav a:hover {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 5px;
  }
  .header-nav .header-wide {
    display: none;
  }
  @media (min-width: 640px) {
    .header-nav .header-wide {
      display: inline-flex;
    }
  }
  @media (max-width: 359px) {
    .header-nav {
      gap: var(--space-2);
    }
  }
</style>
