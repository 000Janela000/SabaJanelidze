---
// The sticky site header: the name and the main links. Nothing else, so it can never overflow:
// phones (under 640 px) show the name, "Work" and "Contact"; wider screens show all five links (the last is the
// quiet "CV", Phase 1d fix 11).
// The theme switch lives in the footer. Nav links change instantly (motion rule 5).
import { nav } from "../content/site-chrome";
import { PERSON } from "../lib/site";

// Section links are "#work" on the home page and "/#work" everywhere else.
const onHome = Astro.url.pathname === "/" || Astro.url.pathname === "/index.html";
const link = (href: string) => (onHome || !href.startsWith("#") ? href : `/${href}`);
---
<header class="hd">
  <div class="ui-wrap hd-row">
    <a class="hd-logo" href="/">{PERSON.name}</a>
    <nav class="hd-nav" aria-label="Main">
      {nav.map((n) => <a class:list={[{ "hd-wide": !n.onPhone }]} href={link(n.href)}>{n.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .hd {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .hd-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: var(--header-h);
  }
  .hd-logo {
    flex: none;
    color: var(--fg);
    font-weight: var(--weight-strong);
    text-decoration: none;
    white-space: nowrap;
  }
  .hd-nav {
    display: flex;
    align-items: center;
    gap: var(--space-1) var(--space-5);
    min-width: 0;
    font-size: var(--fs-sm);
  }
  .hd-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-1);
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .hd-nav a:hover {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 5px;
  }
  .hd-nav .hd-wide {
    display: none;
  }
  @media (min-width: 640px) {
    .hd-nav .hd-wide {
      display: inline-flex;
    }
  }
  @media (max-width: 359px) {
    .hd-nav {
      gap: var(--space-2);
    }
  }
</style>
