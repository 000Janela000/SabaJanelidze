---
// The theme switch in the footer: "Theme: Light · Dark · Auto", three real buttons with aria-pressed,
// shown as plain text; the active one is underlined (Phase 1e).
// - Auto (the default) follows the visitor's system setting; Light and Dark are remembered in
//   localStorage (key "theme", values "light" / "dark"). If storage is blocked, the choice lasts for this page.
// - Hidden without JavaScript (it could not work); the page then follows the system setting.
// - Switches instantly: no animation (motion rule 5, and Saba's "calm" brief).
import { themeSwitch } from "../content/site-chrome";
const o = themeSwitch.options;
---
<div class="ts" role="group" aria-labelledby="ts-label" data-theme-switch>
  <span id="ts-label" class="ts-label">{themeSwitch.label}</span>
  <span class="ts-opts">
    <button type="button" class="ts-btn" data-set="light" aria-pressed="false">{o.light}</button>
    <button type="button" class="ts-btn" data-set="dark" aria-pressed="false">{o.dark}</button>
    <button type="button" class="ts-btn" data-set="auto" aria-pressed="true">{o.auto}</button>
  </span>
</div>

<style>
  /* Plain text buttons (Phase 1d fix 14): no box, no fill. The active one is underlined in the accent and
     marked with aria-pressed; the others are muted and underline on hover. Instant, no animation. */
  .ts {
    display: none;
    align-items: center;
    gap: var(--space-2);
  }
  :global(html.js) .ts {
    display: inline-flex;
  }
  .ts-label {
    color: var(--muted);
  }
  .ts-opts {
    display: inline-flex;
    gap: var(--space-1);
  }
  .ts-btn {
    min-height: 44px;
    padding: 0 0.5rem;
    border: 0;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: var(--fs-sm);
    text-decoration: none;
    text-underline-offset: 5px;
    cursor: pointer;
  }
  .ts-btn:hover {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
  }
  .ts-btn[aria-pressed="true"] {
    color: var(--fg);
    font-weight: var(--weight-strong);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }
</style>

<script>
  type Choice = "light" | "dark" | "auto";
  const root = document.documentElement;
  const dark = window.matchMedia("(prefers-color-scheme: dark)");
  const COLOR = { light: "#f7f5f0", dark: "#15181d" };
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-theme-switch] [data-set]"));

  const choice = (): Choice => {
    const t = root.getAttribute("data-theme");
    return t === "light" || t === "paper" ? "light" : t === "dark" || t === "blueprint" ? "dark" : "auto";
  };

  function sync() {
    const c = choice();
    for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.set === c));
    const shown = c === "auto" ? (dark.matches ? "dark" : "light") : c;
    for (const m of document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')) {
      // "Auto": give the two media-specific tags back their own colours.
      const own = m.media.includes("dark") ? COLOR.dark : COLOR.light;
      m.setAttribute("content", c === "auto" ? own : COLOR[shown]);
    }
  }

  function apply(c: Choice) {
    if (c === "auto") root.removeAttribute("data-theme");
    else root.setAttribute("data-theme", c);
    try {
      if (c === "auto") localStorage.removeItem("theme");
      else localStorage.setItem("theme", c);
    } catch {
      // Storage blocked: the choice lasts for this page only.
    }
    sync();
  }

  for (const b of buttons) b.addEventListener("click", () => apply(b.dataset.set as Choice));
  dark.addEventListener("change", sync);
  sync();
</script>
