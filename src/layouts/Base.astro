---
// Page shell for every page: <head> (SEO, fonts, theme), skip link, and an optional design-preview strip.
import "../styles/global.css";
import SeoHead from "../components/SeoHead.astro";
import Fonts from "../components/Fonts.astro";
import type { Lang } from "../lib/site";

interface Props {
  title: string;
  description: string;
  lang: Lang;
  path: string;
  alternates?: Lang[];
  noindex?: boolean;
  jsonLd?: object | object[];
  ogType?: "website" | "profile";
  /** Class on <body>: each design direction sets its color tokens on its own class. */
  bodyClass?: string;
  themeColor?: string;
  colorScheme?: string;
  /** Paper / Blueprint themes (src/styles/tokens.css). Adds the no-flash theme script and per-theme browser colours. */
  themed?: boolean;
  /** On /design pages: which direction is shown (draws the thin preview strip on top). */
  preview?: "a" | "b" | "b-rich" | "c" | "index" | "ka-b";
}

const {
  title,
  description,
  lang,
  path,
  alternates,
  noindex,
  jsonLd,
  ogType,
  bodyClass,
  themeColor = "#ffffff",
  colorScheme = "light",
  themed = false,
  preview,
} = Astro.props;

// Runs before the first paint, so the page never flashes the wrong theme:
// marks that JavaScript works (class "js") and applies a theme the visitor picked earlier.
// localStorage can throw (private mode, blocked storage); then the system setting decides, as without JavaScript.
// Keep it tiny; a later Content-Security-Policy allows it by its hash.
const themeBoot = `(function(){var d=document.documentElement;d.classList.add("js");try{var t=localStorage.getItem("theme");if(t==="paper"||t==="blueprint"){d.setAttribute("data-theme",t);var c=t==="paper"?"#f5f3ec":"#0a0b0e";document.querySelectorAll('meta[name="theme-color"]').forEach(function(m){m.setAttribute("content",c)})}}catch(e){}})();`;

// No approved Georgian exists for "Skip to content" yet, so it stays English (lang="en") on Georgian pages too.
const skip = "Skip to content";
const strip = [
  { id: "index", label: "All directions", href: "/design" },
  { id: "a", label: "A · Calm precision", href: "/design/a" },
  { id: "b", label: "B · Dark, light and fast", href: "/design/b" },
  { id: "b-rich", label: "B-rich · B + shader", href: "/design/b-rich" },
  { id: "c", label: "C · Engineering notebook", href: "/design/c" },
  { id: "ka-b", label: "B in Georgian", href: "/ka/design/b" },
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      title={title}
      description={description}
      lang={lang}
      path={path}
      alternates={alternates}
      noindex={noindex}
      jsonLd={jsonLd}
      ogType={ogType}
    />
    <Fonts georgian={lang === "ka"} />
    {
      themed ? (
        <>
          <meta name="color-scheme" content="light dark" />
          <meta name="theme-color" content="#f5f3ec" media="(prefers-color-scheme: light)" />
          <meta name="theme-color" content="#0a0b0e" media="(prefers-color-scheme: dark)" />
          <script is:inline set:html={themeBoot} />
        </>
      ) : (
        <>
          <meta name="theme-color" content={themeColor} />
          <meta name="color-scheme" content={colorScheme} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main" lang="en">{skip}</a>
    {
      preview && (
        <nav class="preview-strip" aria-label="Design preview" lang="en">
          <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-4 gap-y-1 px-4 py-1.5">
            <span>Phase 1 design preview (not public)</span>
            {strip.map((s) => (
              <a href={s.href} aria-current={s.id === preview ? "page" : undefined}>
                {s.label}
              </a>
            ))}
          </div>
        </nav>
      )
    }
    <slot />
  </body>
</html>
